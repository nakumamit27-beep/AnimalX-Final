{"memory_id": 381, "messages": [{"role": "assistant", "content": [{"type": "text", "text": "Clean \u2014 no errors. Now appending all the new CSS for every new component:"}]}, {"role": "assistant", "content": [], "tool_calls": [{"type": "tool", "name": "bash", "arguments": {"command": "cat >> artifacts/animal-x/src/styles/app.css << 'ENDOFCSS'\n\n/* ===================================================================\n   UPLOAD REEL \u2014 Redesigned wizard (v2.5)\n   =================================================================== */\n.upload-backdrop {\n  position: fixed; inset: 0; z-index: 2000;\n  background: rgba(0,0,0,0.75);\n  backdrop-filter: blur(8px);\n  display: flex; align-items: flex-end; justify-content: center;\n  animation: fadeIn 0.2s ease;\n}\n@media (min-width: 600px) {\n  .upload-backdrop { align-items: center; }\n}\n\n.upload-sheet {\n  background: var(--bg2);\n  border: 1px solid var(--border);\n  border-radius: 20px 20px 0 0;\n  width: 100%; max-width: 560px;\n  max-height: 92dvh;\n  display: flex; flex-direction: column;\n  overflow: hidden;\n  animation: slideUp 0.3s cubic-bezier(0.34,1.56,0.64,1);\n}\n@media (min-width: 600px) {\n  .upload-sheet { border-radius: 20px; max-height: 85vh; }\n}\n@keyframes slideUp {\n  from { transform: translateY(60px); opacity: 0; }\n  to   { transform: translateY(0); opacity: 1; }\n}\n\n.upload-header {\n  display: flex; flex-direction: column; gap: 12px;\n  padding: 16px 20px 12px;\n  border-bottom: 1px solid var(--border);\n  position: relative;\n}\n.upload-close-btn {\n  position: absolute; top: 14px; right: 16px;\n  background: var(--bg3); border: none; color: var(--text2);\n  width: 30px; height: 30px; border-radius: 50%; font-size: 0.9rem;\n  cursor: pointer; display: flex; align-items: center; justify-content: center;\n}\n.upload-close-btn:hover { color: var(--text); background: var(--border); }\n.upload-header-title {\n  font-size: 1.05rem; font-weight: 700; color: var(--text);\n  text-align: center; padding-right: 36px;\n}\n.upload-step-dots {\n  display: flex; gap: 6px; justify-content: center;\n}\n.upload-dot {\n  display: flex; flex-direction: column; align-items: center; gap: 3px;\n  flex: 1; max-width: 90px;\n}\n.upload-dot-num {\n  width: 28px; height: 28px; border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 0.8rem; font-weight: 700;\n  background: var(--bg3); color: var(--text2);\n  border: 2px solid var(--border);\n  transition: all 0.2s;\n}\n.upload-dot.active .upload-dot-num {\n  background: var(--accent); color: #fff; border-color: var(--accent);\n}\n.upload-dot.done .upload-dot-num {\n  background: rgba(34,197,94,0.2); color: var(--accent); border-color: var(--accent);\n}\n.upload-dot-label {\n  font-size: 0.7rem; color: var(--text2);\n}\n.upload-dot.active .upload-dot-label { color: var(--accent); font-weight: 600; }\n.upload-dot.done .upload-dot-label { color: var(--accent); }\n\n.upload-body {\n  flex: 1; overflow-y: auto;\n  padding: 16px 20px;\n  scrollbar-width: thin;\n}\n\n.upload-error-bar {\n  background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.4);\n  border-radius: 10px; padding: 10px 14px;\n  color: #fca5a5; font-size: 0.85rem;\n  display: flex; align-items: center; gap: 8px;\n  margin-bottom: 12px;\n}\n.upload-error-dismiss {\n  background: none; border: none; color: #fca5a5; cursor: pointer; margin-left: auto;\n}\n\n.upload-banned-card {\n  text-align: center; padding: 32px 20px;\n  display: flex; flex-direction: column; align-items: center; gap: 12px;\n}\n.upload-banned-card h3 { font-size: 1.1rem; color: #fca5a5; }\n.upload-banned-card p { color: var(--text2); font-size: 0.88rem; line-height: 1.5; }\n\n.upload-warning-card {\n  background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.4);\n  border-radius: 14px; padding: 16px; margin-bottom: 16px;\n  display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center;\n}\n.upload-warning-icon { font-size: 2.5rem; }\n.upload-warning-text strong { color: #fcd34d; font-size: 0.95rem; }\n.upload-warning-text p { color: var(--text2); font-size: 0.82rem; line-height: 1.5; margin-top: 4px; }\n.upload-warning-actions { display: flex; gap: 8px; width: 100%; }\n.upload-warn-revise {\n  flex: 1; padding: 9px; border-radius: 10px;\n  background: var(--bg3); border: 1px solid var(--border); color: var(--text);\n  font-size: 0.85rem; font-weight: 600; cursor: pointer;\n}\n.upload-warn-proceed {\n  flex: 1; padding: 9px; border-radius: 10px;\n  background: rgba(245,158,11,0.2); border: 1px solid rgba(245,158,11,0.5);\n  color: #fcd34d; font-size: 0.82rem; font-weight: 600; cursor: pointer;\n}\n.upload-warn-proceed:hover { background: rgba(245,158,11,0.3); }\n\n.upload-step-body { display: flex; flex-direction: column; gap: 0; }\n\n.upload-form-grid { display: flex; flex-direction: column; gap: 12px; }\n.upload-field { display: flex; flex-direction: column; gap: 4px; }\n.upload-label { font-size: 0.82rem; font-weight: 600; color: var(--text2); }\n.upload-required { color: var(--accent); }\n.upload-optional { color: var(--text2); font-weight: 400; }\n.upload-input {\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 10px;\n  padding: 10px 12px; color: var(--text); font-size: 0.9rem;\n  transition: border-color 0.2s;\n}\n.upload-input:focus { outline: none; border-color: var(--accent); }\n.upload-textarea {\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 10px;\n  padding: 10px 12px; color: var(--text); font-size: 0.9rem;\n  resize: vertical; min-height: 72px;\n}\n.upload-textarea:focus { outline: none; border-color: var(--accent); }\n.upload-select {\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 10px;\n  padding: 10px 12px; color: var(--text); font-size: 0.9rem;\n}\n.upload-char-count { font-size: 0.72rem; color: var(--text2); text-align: right; }\n.upload-row-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n.upload-ai-note {\n  background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.25);\n  border-radius: 10px; padding: 10px 12px;\n  font-size: 0.8rem; color: var(--text2);\n}\n\n.upload-dropzone {\n  border: 2px dashed var(--border); border-radius: 16px;\n  min-height: 200px; display: flex; align-items: center; justify-content: center;\n  cursor: pointer; transition: border-color 0.2s; overflow: hidden;\n  position: relative;\n}\n.upload-dropzone:hover, .upload-dropzone.has-file { border-color: var(--accent); }\n.upload-dropzone-inner {\n  display: flex; flex-direction: column; align-items: center; gap: 8px;\n  padding: 32px;\n}\n.upload-dropzone-icon { font-size: 3.5rem; }\n.upload-dropzone-title { font-size: 1rem; font-weight: 600; color: var(--text); }\n.upload-dropzone-hint { font-size: 0.8rem; color: var(--text2); }\n.upload-preview-vid {\n  width: 100%; max-height: 280px; object-fit: contain; border-radius: 14px;\n}\n.upload-file-chip {\n  display: flex; align-items: center; gap: 8px;\n  background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3);\n  border-radius: 10px; padding: 8px 12px;\n  font-size: 0.82rem; color: var(--accent); margin-top: 10px;\n}\n.upload-file-size { color: var(--text2); }\n.upload-file-remove {\n  background: none; border: none; color: var(--text2); cursor: pointer; margin-left: auto;\n}\n.upload-thumb-section { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; }\n.upload-thumb-btn {\n  padding: 9px 14px; border-radius: 10px;\n  background: var(--bg3); border: 1px solid var(--border); color: var(--text2);\n  font-size: 0.85rem; cursor: pointer; text-align: left;\n}\n.upload-thumb-btn:hover { border-color: var(--accent); color: var(--accent); }\n\n.upload-review-card {\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 14px;\n  padding: 16px; display: flex; flex-direction: column; gap: 8px;\n  margin-bottom: 14px;\n}\n.upload-review-header { display: flex; gap: 8px; align-items: center; }\n.upload-review-cat-badge {\n  background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.3);\n  color: var(--accent); border-radius: 20px; padding: 3px 10px; font-size: 0.78rem; font-weight: 600;\n}\n.upload-review-loc { font-size: 0.8rem; color: var(--text2); }\n.upload-review-title { font-size: 1rem; font-weight: 700; color: var(--text); }\n.upload-review-desc { font-size: 0.85rem; color: var(--text2); line-height: 1.5; }\n.upload-review-tags { display: flex; flex-wrap: wrap; gap: 5px; }\n.upload-review-tag {\n  background: rgba(59,130,246,0.15); color: var(--accent-blue);\n  border-radius: 20px; padding: 2px 8px; font-size: 0.75rem;\n}\n.upload-review-file-row {\n  display: flex; align-items: center; gap: 6px;\n  font-size: 0.8rem; color: var(--text2);\n  border-top: 1px solid var(--border); padding-top: 8px;\n}\n\n.upload-guidelines-box {\n  background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 12px;\n  padding: 12px 14px; display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px;\n}\n.upload-guidelines-title { font-size: 0.85rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }\n.upload-guideline-row { font-size: 0.8rem; color: var(--text2); }\n\n.upload-progress-wrap { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }\n.upload-progress-track {\n  height: 6px; background: var(--bg3); border-radius: 3px; overflow: hidden;\n}\n.upload-progress-fill {\n  height: 100%; background: linear-gradient(90deg, var(--accent2), var(--accent));\n  border-radius: 3px; transition: width 0.4s ease;\n}\n.upload-progress-label { font-size: 0.8rem; color: var(--text2); text-align: center; }\n\n.upload-footer {\n  display: flex; align-items: center; gap: 10px;\n  padding: 12px 20px 16px;\n  border-top: 1px solid var(--border);\n  background: var(--bg2);\n}\n.upload-btn-back {\n  padding: 10px 16px; border-radius: 12px;\n  background: var(--bg3); border: 1px solid var(--border); color: var(--text2);\n  font-size: 0.88rem; font-weight: 600; cursor: pointer;\n}\n.upload-btn-back:hover { border-color: var(--accent); color: var(--text); }\n.upload-btn-next {\n  padding: 11px 22px; border-radius: 12px;\n  background: var(--accent); color: #fff;\n  border: none; font-size: 0.9rem; font-weight: 700; cursor: pointer;\n  transition: background 0.2s, transform 0.1s;\n}\n.upload-btn-next:hover { background: var(--accent2); transform: scale(1.02); }\n.upload-btn-post {\n  padding: 11px 22px; border-radius: 12px;\n  background: linear-gradient(135deg, #22c55e, #16a34a);\n  color: #fff; border: none; font-size: 0.9rem; font-weight: 700;\n  cursor: pointer; transition: opacity 0.2s, transform 0.1s;\n  min-width: 140px;\n}\n.upload-btn-post:disabled { opacity: 0.6; cursor: default; transform: none; }\n.upload-btn-post:not(:disabled):hover { opacity: 0.9; transform: scale(1.02); }\n\n/* ===================================================================\n   WILDLIFE AI \u2014 \ud83e\uddb4 FAB + Animated Menu + ChatGPT-style panel\n   =================================================================== */\n\n/* FAB button */\n.wai-fab {\n  position: fixed; bottom: 88px; right: 20px; z-index: 1200;\n  width: 56px; height: 56px; border-radius: 50%;\n  background: linear-gradient(135deg, #065f46, #22c55e);\n  border: none; cursor: pointer; box-shadow: 0 4px 20px rgba(34,197,94,0.4);\n  display: flex; align-items: center; justify-content: center;\n  transition: transform 0.2s, box-shadow 0.2s;\n  font-size: 1.6rem;\n}\n.wai-fab:hover { transform: scale(1.1); box-shadow: 0 6px 28px rgba(34,197,94,0.6); }\n.wai-fab.wai-fab-active { transform: scale(1.05) rotate(45deg); }\n.wai-fab-bone { font-size: 1.6rem; line-height: 1; }\n.wai-fab-close { font-size: 1.2rem; color: #fff; font-weight: 700; }\n\n/* Backdrop */\n.wai-menu-backdrop {\n  position: fixed; inset: 0; z-index: 1150;\n  background: rgba(0,0,0,0.3);\n  backdrop-filter: blur(2px);\n  animation: fadeIn 0.15s ease;\n}\n\n/* Animated vertical menu */\n.wai-menu {\n  position: fixed; bottom: 154px; right: 14px; z-index: 1190;\n  display: flex; flex-direction: column; gap: 6px;\n  align-items: flex-end;\n}\n.wai-menu-item {\n  display: flex; align-items: center; gap: 10px;\n  background: var(--bg2); border: 1px solid var(--border);\n  border-radius: 30px; padding: 9px 16px 9px 12px;\n  cursor: pointer; font-size: 0.88rem; font-weight: 500;\n  color: var(--text); box-shadow: 0 4px 16px rgba(0,0,0,0.4);\n  white-space: nowrap;\n  animation: menuItemIn 0.25s cubic-bezier(0.34,1.56,0.64,1) both;\n  transition: background 0.15s, transform 0.15s;\n}\n.wai-menu-item:hover {\n  background: var(--bg3); border-color: var(--accent);\n  transform: translateX(-4px);\n}\n@keyframes menuItemIn {\n  from { opacity: 0; transform: translateX(20px) scale(0.8); }\n  to   { opacity: 1; transform: translateX(0) scale(1); }\n}\n.wai-menu-icon { font-size: 1.2rem; }\n.wai-menu-label { font-size: 0.87rem; }\n\n/* Chat Panel */\n.wai-panel {\n  position: fixed; bottom: 80px; right: 16px; z-index: 1300;\n  width: min(400px, calc(100vw - 20px));\n  height: min(580px, calc(100dvh - 100px));\n  background: var(--bg2); border: 1px solid var(--border);\n  border-radius: 20px; display: flex; flex-direction: column;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.6);\n  animation: panelIn 0.3s cubic-bezier(0.34,1.56,0.64,1);\n  overflow: hidden;\n}\n@keyframes panelIn {\n  from { opacity: 0; transform: scale(0.9) translateY(20px); }\n  to   { opacity: 1; transform: scale(1) translateY(0); }\n}\n\n.wai-panel-header {\n  display: flex; align-items: center; gap: 10px;\n  padding: 12px 14px; border-bottom: 1px solid var(--border);\n  background: var(--bg3);\n  flex-shrink: 0;\n}\n.wai-back-btn {\n  background: none; border: none; color: var(--text2);\n  font-size: 1.2rem; cursor: pointer; padding: 4px;\n  border-radius: 8px; transition: color 0.15s;\n}\n.wai-back-btn:hover { color: var(--accent); }\n.wai-header-info { display: flex; align-items: center; gap: 10px; flex: 1; }\n.wai-header-avatar {\n  width: 36px; height: 36px; border-radius: 50%;\n  background: linear-gradient(135deg, #065f46, #22c55e);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 1.1rem; flex-shrink: 0;\n}\n.wai-header-title { font-size: 0.9rem; font-weight: 700; color: var(--text); }\n.wai-header-sub { font-size: 0.72rem; color: var(--accent); }\n.wai-close-btn {\n  background: none; border: none; color: var(--text2);\n  font-size: 1rem; cursor: pointer; padding: 6px; border-radius: 8px;\n}\n.wai-close-btn:hover { color: var(--text); }\n\n.wai-chat-search {\n  display: flex; align-items: center; gap: 6px;\n  padding: 8px 12px; border-bottom: 1px solid var(--border);\n  background: var(--bg3);\n  flex-shrink: 0;\n}\n.wai-search-input {\n  flex: 1; background: var(--bg2); border: 1px solid var(--border); border-radius: 8px;\n  padding: 6px 10px; color: var(--text); font-size: 0.82rem;\n}\n.wai-search-clear {\n  background: none; border: none; color: var(--text2); cursor: pointer; font-size: 0.85rem;\n}\n\n.wai-messages {\n  flex: 1; overflow-y: auto; padding: 14px 12px;\n  display: flex; flex-direction: column; gap: 12px;\n  scrollbar-width: thin;\n}\n\n.wai-msg-row {\n  display: flex; align-items: flex-start; gap: 8px;\n}\n.wai-msg-row.user { flex-direction: row-reverse; }\n\n.wai-msg-avatar-sm {\n  width: 30px; height: 30px; border-radius: 50%;\n  background: linear-gradient(135deg, #065f46, #22c55e);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 0.9rem; flex-shrink: 0; margin-top: 2px;\n}\n\n.wai-bubble {\n  max-width: 80%; padding: 10px 12px; border-radius: 14px;\n  font-size: 0.85rem; line-height: 1.55;\n}\n.wai-bubble.ai {\n  background: var(--bg3); border: 1px solid var(--border); color: var(--text);\n  border-radius: 4px 14px 14px 14px;\n}\n.wai-bubble.user {\n  background: linear-gradient(135deg, #065f46, #22c55e);\n  color: #fff; border-radius: 14px 14px 4px 14px;\n}\n.wai-typing { display: flex; align-items: center; gap: 5px; padding: 12px 16px; }\n.wai-dot {\n  width: 7px; height: 7px; border-radius: 50%; background: var(--text2);\n  animation: dotBounce 1.4s infinite;\n}\n.wai-dot:nth-child(2) { animation-delay: 0.2s; }\n.wai-dot:nth-child(3) { animation-delay: 0.4s; }\n@keyframes dotBounce {\n  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }\n  40% { transform: translateY(-6px); opacity: 1; }\n}\n\n.wai-msg-content { display: flex; flex-direction: column; gap: 2px; }\n.wai-line { line-height: 1.55; }\n.wai-list-item { padding-left: 4px; }\n.wai-msg-spacer { height: 4px; }\n\n.wai-suggestions {\n  padding: 10px 12px; border-top: 1px solid var(--border);\n  background: var(--bg3);\n  flex-shrink: 0;\n}\n.wai-suggestions-label { font-size: 0.75rem; color: var(--text2); margin-bottom: 7px; }\n.wai-suggestions-scroll {\n  display: flex; flex-wrap: wrap; gap: 6px;\n  max-height: 100px; overflow-y: auto;\n}\n.wai-chip {\n  padding: 5px 12px; border-radius: 20px; font-size: 0.78rem;\n  background: var(--bg2); border: 1px solid var(--border); color: var(--text2);\n  cursor: pointer; white-space: nowrap; transition: all 0.15s;\n}\n.wai-chip:hover { border-color: var(--accent); color: var(--accent); }\n\n.wai-input-row {\n  display: flex; gap: 8px; align-items: center;\n  padding: 10px 12px; border-top: 1px solid var(--border);\n  background: var(--bg2);\n  flex-shrink: 0;\n}\n.wai-input {\n  flex: 1; background: var(--bg3); border: 1px solid var(--border); border-radius: 22px;\n  padding: 10px 16px; color: var(--text); font-size: 0.88rem;\n  transition: border-color 0.2s;\n}\n.wai-input:focus { outline: none; border-color: var(--accent); }\n.wai-send-btn {\n  width: 38px; height: 38px; border-radius: 50%;\n  background: var(--accent); border: none; color: #fff;\n  font-size: 1rem; cursor: pointer;\n  display: flex; align-items: center; justify-content: center;\n  transition: background 0.15s, transform 0.1s;\n  flex-shrink: 0;\n}\n.wai-send-btn:hover:not(:disabled) { background: var(--accent2); transform: scale(1.05); }\n.wai-send-btn:disabled { background: var(--bg3); color: var(--text2); cursor: default; }\n\n/* ===================================================================\n   POLICY PAGES (Privacy, Terms, Guidelines)\n   =================================================================== */\n.policy-page {\n  min-height: 100%;\n  background: var(--bg);\n  padding-bottom: 100px;\n}\n\n.policy-header {\n  background: linear-gradient(180deg, var(--bg2), var(--bg));\n  padding: 20px 20px 24px;\n  display: flex; flex-direction: column; align-items: center; gap: 8px;\n  border-bottom: 1px solid var(--border);\n  position: relative;\n}\n.policy-back {\n  position: absolute; top: 18px; left: 16px;\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 20px;\n  padding: 6px 14px; color: var(--text2); font-size: 0.85rem; cursor: pointer;\n}\n.policy-back:hover { border-color: var(--accent); color: var(--accent); }\n.policy-header-icon { font-size: 3rem; margin-top: 8px; }\n.policy-title {\n  font-size: 1.6rem; font-weight: 800; color: var(--text); text-align: center;\n}\n.policy-subtitle { font-size: 0.82rem; color: var(--text2); }\n\n.policy-body { max-width: 720px; margin: 0 auto; padding: 24px 20px; }\n\n.policy-section {\n  margin-bottom: 28px;\n}\n.policy-section h2 {\n  font-size: 1.1rem; font-weight: 700; color: var(--text);\n  margin-bottom: 12px; padding-bottom: 8px;\n  border-bottom: 1px solid var(--border);\n}\n.policy-section h3 {\n  font-size: 0.95rem; font-weight: 700; margin-bottom: 8px;\n}\n.policy-section p {\n  color: var(--text2); font-size: 0.88rem; line-height: 1.7; margin-bottom: 8px;\n}\n.policy-list {\n  color: var(--text2); font-size: 0.88rem; line-height: 1.7;\n  padding-left: 20px; display: flex; flex-direction: column; gap: 6px;\n}\n.policy-link { color: var(--accent); text-decoration: underline; }\n\n.policy-card {\n  border-radius: 12px; padding: 14px 16px; margin-bottom: 12px;\n}\n.policy-card.green {\n  background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.25);\n}\n.policy-card.green h3 { color: var(--accent); }\n.policy-card.blue {\n  background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.25);\n}\n.policy-card.blue h3 { color: #60a5fa; }\n.policy-card.red {\n  background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25);\n}\n.policy-card.red h3 { color: #fca5a5; }\n.policy-card.orange {\n  background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25);\n}\n.policy-card.orange h3 { color: #fcd34d; }\n.policy-card ul {\n  color: var(--text2); font-size: 0.85rem; padding-left: 18px;\n  display: flex; flex-direction: column; gap: 4px;\n}\n\n.policy-intro-card {\n  background: linear-gradient(135deg, rgba(34,197,94,0.08), rgba(6,95,70,0.15));\n  border: 1px solid rgba(34,197,94,0.2); border-radius: 16px;\n  padding: 20px; text-align: center;\n  display: flex; flex-direction: column; align-items: center; gap: 10px;\n}\n.policy-intro-card p { color: var(--text2); font-size: 0.9rem; line-height: 1.6; }\n\n.policy-grid {\n  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\n  margin-top: 12px;\n}\n@media (max-width: 500px) { .policy-grid { grid-template-columns: 1fr; } }\n\n.policy-good-card {\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 12px;\n  padding: 14px; display: flex; flex-direction: column; gap: 6px;\n}\n.policy-good-icon { font-size: 1.8rem; }\n.policy-good-card h3 { font-size: 0.88rem; font-weight: 700; color: var(--text); }\n.policy-good-card p { font-size: 0.78rem; color: var(--text2); line-height: 1.5; }\n\n.policy-rule-block {\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 12px;\n  padding: 14px 16px; margin-bottom: 10px; position: relative;\n}\n.policy-rule-badge {\n  display: inline-block; font-size: 0.7rem; font-weight: 700;\n  padding: 2px 8px; border-radius: 20px; margin-bottom: 6px;\n}\n.policy-rule-badge.red {\n  background: rgba(239,68,68,0.15); color: #fca5a5; border: 1px solid rgba(239,68,68,0.3);\n}\n.policy-rule-badge.orange {\n  background: rgba(245,158,11,0.15); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3);\n}\n.policy-rule-block h3 { font-size: 0.92rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }\n.policy-rule-block p { font-size: 0.82rem; color: var(--text2); line-height: 1.5; }\n\n.policy-strike-timeline {\n  display: flex; flex-direction: column; gap: 0; margin-top: 12px;\n}\n.policy-strike-step {\n  display: flex; align-items: flex-start; gap: 14px;\n  padding: 14px 16px;\n  border-left: 3px solid var(--border);\n  position: relative; margin-left: 18px;\n}\n.policy-strike-step.green { border-color: var(--accent); }\n.policy-strike-step.orange { border-color: #f59e0b; }\n.policy-strike-step.red { border-color: #ef4444; }\n.policy-strike-step.black { border-color: #6b7280; }\n.policy-strike-num {\n  position: absolute; left: -18px;\n  width: 32px; height: 32px; border-radius: 50%;\n  background: var(--bg3); border: 2px solid currentColor;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 0.85rem; font-weight: 700;\n}\n.policy-strike-step.green .policy-strike-num { color: var(--accent); }\n.policy-strike-step.orange .policy-strike-num { color: #f59e0b; }\n.policy-strike-step.red .policy-strike-num { color: #ef4444; }\n.policy-strike-step.black .policy-strike-num { color: #6b7280; font-size: 0.9rem; }\n.policy-strike-step strong { font-size: 0.9rem; color: var(--text); }\n.policy-strike-step p { font-size: 0.82rem; color: var(--text2); margin-top: 2px; line-height: 1.5; }\n\n.policy-contact-box {\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 12px;\n  padding: 14px 16px; display: flex; flex-direction: column; gap: 8px;\n  font-size: 0.88rem; color: var(--text2);\n}\n.policy-footer-note {\n  text-align: center; font-size: 0.78rem; color: var(--text2);\n  padding: 20px 0; border-top: 1px solid var(--border);\n  margin-top: 32px;\n}\n\n/* ===================================================================\n   ADMIN TESTING PANEL\n   =================================================================== */\n.atp-backdrop {\n  position: fixed; inset: 0; z-index: 2100;\n  background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);\n  display: flex; align-items: flex-end; justify-content: center;\n  animation: fadeIn 0.2s ease;\n}\n@media (min-width: 600px) {\n  .atp-backdrop { align-items: center; }\n}\n\n.atp-panel {\n  background: var(--bg2); border: 1px solid var(--border);\n  border-radius: 20px 20px 0 0; width: 100%; max-width: 500px;\n  max-height: 88dvh; display: flex; flex-direction: column;\n  animation: slideUp 0.3s cubic-bezier(0.34,1.56,0.64,1);\n  overflow: hidden; position: relative;\n}\n@media (min-width: 600px) {\n  .atp-panel { border-radius: 20px; max-height: 80vh; }\n}\n\n.atp-header {\n  display: flex; align-items: center; gap: 12px;\n  padding: 16px 20px; border-bottom: 1px solid var(--border);\n  background: var(--bg3);\n}\n.atp-header-icon { font-size: 1.8rem; }\n.atp-header-title { font-size: 1rem; font-weight: 700; color: var(--text); }\n.atp-header-sub { font-size: 0.75rem; color: var(--text2); }\n.atp-close {\n  margin-left: auto; background: none; border: none; color: var(--text2);\n  font-size: 1.1rem; cursor: pointer; padding: 6px; border-radius: 8px;\n}\n\n.atp-mode-banner {\n  margin: 12px 16px 0; padding: 10px 14px; border-radius: 10px; border: 1px solid;\n  display: flex; flex-direction: column; gap: 2px;\n  flex-shrink: 0;\n}\n.atp-mode-desc { font-size: 0.78rem; color: var(--text2); }\n\n.atp-tabs {\n  display: flex; gap: 0; border-bottom: 1px solid var(--border);\n  padding: 0 16px; margin-top: 12px;\n  flex-shrink: 0;\n}\n.atp-tab {\n  padding: 8px 14px; font-size: 0.85rem; font-weight: 600;\n  background: none; border: none; color: var(--text2); cursor: pointer;\n  border-bottom: 2px solid transparent; transition: all 0.15s;\n}\n.atp-tab.active { color: var(--accent); border-bottom-color: var(--accent); }\n.atp-tab:hover { color: var(--text); }\n\n.atp-tab-body {\n  flex: 1; overflow-y: auto; padding: 14px 16px;\n  display: flex; flex-direction: column; gap: 8px;\n  scrollbar-width: thin;\n}\n.atp-section-label { font-size: 0.75rem; font-weight: 700; color: var(--text2); text-transform: uppercase; letter-spacing: 0.05em; }\n.atp-beta-note { font-size: 0.72rem; color: #f59e0b; font-weight: 400; text-transform: none; }\n\n.atp-mode-btn {\n  width: 100%; text-align: left; padding: 12px 14px; border-radius: 12px;\n  background: var(--bg3); border: 1px solid var(--border); cursor: pointer;\n  display: flex; flex-direction: column; gap: 3px; position: relative;\n  transition: border-color 0.2s;\n}\n.atp-mode-btn:hover { border-color: var(--accent); }\n.atp-mode-btn-label { font-size: 0.9rem; font-weight: 700; color: var(--text); }\n.atp-mode-btn-desc { font-size: 0.78rem; color: var(--text2); }\n.atp-mode-active-badge {\n  position: absolute; top: 10px; right: 12px;\n  font-size: 0.68rem; font-weight: 700; color: var(--accent);\n}\n\n.atp-action-row { display: flex; gap: 8px; }\n.atp-action-btn {\n  flex: 1; padding: 11px; border-radius: 12px;\n  font-size: 0.85rem; font-weight: 700; cursor: pointer; border: none;\n  transition: opacity 0.15s, transform 0.1s; text-align: center;\n  display: flex; align-items: center; justify-content: center;\n}\n.atp-action-btn:hover { opacity: 0.85; transform: scale(1.01); }\n.atp-action-btn.testing { background: rgba(245,158,11,0.2); border: 1px solid rgba(245,158,11,0.4); color: #fcd34d; }\n.atp-action-btn.live { background: rgba(34,197,94,0.2); border: 1px solid rgba(34,197,94,0.4); color: var(--accent); }\n.atp-action-btn.emergency { background: rgba(239,68,68,0.2); border: 1px solid rgba(239,68,68,0.4); color: #fca5a5; width: 100%; }\n.atp-action-btn.disabled { opacity: 0.5; cursor: default; }\n\n.atp-mode-help {\n  font-size: 0.78rem; color: var(--text2); line-height: 1.6;\n  background: var(--bg3); border-radius: 10px; padding: 10px 12px;\n  margin-top: 4px;\n}\n\n.atp-feature-row {\n  display: flex; align-items: center; gap: 12px; padding: 10px 12px;\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 10px;\n  transition: border-color 0.15s;\n}\n.atp-feature-row.on { border-color: rgba(34,197,94,0.4); background: rgba(34,197,94,0.05); }\n.atp-feature-info { flex: 1; }\n.atp-feature-label { font-size: 0.87rem; font-weight: 600; color: var(--text); }\n.atp-feature-desc { font-size: 0.75rem; color: var(--text2); margin-top: 2px; }\n.atp-toggle-switch { position: relative; cursor: pointer; flex-shrink: 0; }\n.atp-toggle-switch input { opacity: 0; width: 0; height: 0; }\n.atp-toggle-track {\n  display: block; width: 44px; height: 24px; border-radius: 12px;\n  background: var(--border); transition: background 0.2s; position: relative;\n}\n.atp-toggle-track::after {\n  content: \"\"; position: absolute; top: 3px; left: 3px;\n  width: 18px; height: 18px; border-radius: 50%; background: #fff;\n  transition: transform 0.2s;\n}\n.atp-toggle-switch input:checked + .atp-toggle-track { background: var(--accent); }\n.atp-toggle-switch input:checked + .atp-toggle-track::after { transform: translateX(20px); }\n\n.atp-backup-status {\n  display: flex; justify-content: space-between; align-items: center;\n  background: var(--bg3); border-radius: 10px; padding: 10px 14px;\n  font-size: 0.82rem; color: var(--text2);\n}\n.atp-backup-count { font-size: 0.78rem; }\n\n.atp-backup-list { display: flex; flex-direction: column; gap: 6px; }\n.atp-backup-item {\n  display: flex; align-items: center; gap: 8px;\n  background: var(--bg3); border: 1px solid var(--border); border-radius: 10px;\n  padding: 8px 12px;\n}\n.atp-backup-time { font-size: 0.8rem; color: var(--text2); flex: 1; }\n.atp-backup-mode { font-size: 0.75rem; color: var(--text2); }\n.atp-backup-restore-btn {\n  padding: 4px 12px; border-radius: 8px; font-size: 0.78rem; font-weight: 600;\n  background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.3);\n  color: var(--accent); cursor: pointer;\n}\n\n.atp-toast {\n  position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%);\n  background: var(--bg3); border: 1px solid var(--border);\n  border-radius: 20px; padding: 8px 18px; font-size: 0.84rem; color: var(--text);\n  white-space: nowrap; box-shadow: 0 4px 16px rgba(0,0,0,0.4);\n  animation: fadeIn 0.2s ease;\n}\n\n/* ===================================================================\n   ADMIN PANEL OVERLAY (in Navbar \u2014 Broadcast + Testing tabs)\n   =================================================================== */\n.admin-panel-overlay {\n  position: fixed; inset: 0; z-index: 1800;\n  background: rgba(0,0,0,0.5); backdrop-filter: blur(6px);\n  display: flex; align-items: flex-start; justify-content: center;\n  padding-top: 70px;\n  animation: fadeIn 0.15s ease;\n}\n.admin-panel-sheet {\n  background: var(--bg2); border: 1px solid var(--border); border-radius: 16px;\n  width: min(480px, calc(100vw - 24px));\n  max-height: calc(100dvh - 90px); overflow-y: auto;\n  display: flex; flex-direction: column;\n  animation: slideDown 0.2s ease;\n}\n@keyframes slideDown {\n  from { opacity: 0; transform: translateY(-10px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n.admin-panel-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 12px 16px; border-bottom: 1px solid var(--border);\n}\n.admin-panel-tabs { display: flex; gap: 4px; }\n.admin-panel-tab {\n  padding: 6px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;\n  background: none; border: 1px solid transparent; color: var(--text2); cursor: pointer;\n}\n.admin-panel-tab.active {\n  background: rgba(34,197,94,0.15); border-color: rgba(34,197,94,0.3); color: var(--accent);\n}\n.admin-panel-close {\n  background: none; border: none; color: var(--text2); cursor: pointer; font-size: 1rem; padding: 4px;\n}\n.admin-panel-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }\n.admin-panel-hint { font-size: 0.82rem; color: var(--text2); }\n.admin-panel-actions { display: flex; gap: 8px; margin-top: 4px; }\n.admin-panel-debug-btn {\n  padding: 10px; border-radius: 10px; font-size: 0.83rem; font-weight: 600;\n  background: rgba(168,85,247,0.15); border: 1px solid rgba(168,85,247,0.3);\n  color: #c084fc; cursor: pointer; width: 100%; margin-top: 4px;\n}\n\n/* ===================================================================\n   PAGE LOADING (animated dots instead of plain text)\n   =================================================================== */\n.page-loading {\n  display: flex; align-items: center; justify-content: center;\n  min-height: 200px; gap: 8px;\n}\n.page-loading-dot {\n  width: 10px; height: 10px; border-radius: 50%; background: var(--accent);\n  animation: dotBounce 1.2s ease-in-out infinite;\n}\n.page-loading-dot:nth-child(2) { animation-delay: 0.2s; background: var(--accent2); }\n.page-loading-dot:nth-child(3) { animation-delay: 0.4s; }\n\n/* ===================================================================\n   RESPONSIVE ADDITIONS\n   =================================================================== */\n@media (max-width: 480px) {\n  .wai-panel { right: 8px; width: calc(100vw - 16px); bottom: 78px; }\n  .wai-fab { bottom: 82px; right: 12px; }\n  .wai-menu { right: 8px; bottom: 148px; }\n  .upload-row-2col { grid-template-columns: 1fr; }\n  .atp-mode-btn { padding: 10px 12px; }\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to   { opacity: 1; }\n}\nENDOFCSS\necho \"CSS appended successfully\"", "description": "Append all new CSS for UploadReel, WildlifeAI, Policy pages, AdminTestingPanel", "timeout": 10000}}]}, {"role": "tool", "content": [{"type": "text", "text": "Command executed successfully.\nThe output was\n```\nCSS appended successfully\n```"}]}]}
