ad\", country: \"India\", lat: 17.35, lng: 78.45, animals: 230, rating: 4.4, image: \"https://loremflickr.com/400/220/zoo,india?lock=108\" },\n  { name: \"National Zoological Park\", city:\"New Delhi\", country: \"India\", lat: 28.60, lng: 77.24, animals: 280, rating: 4.5, image: \"https://loremflickr.com/400/220/zoo,delhi?lock=109\" },\n  { name: \"Indira Gandhi Zoological Park\", city:\"Visakhapatnam\", country: \"India\", lat: 17.74, lng: 83.28, animals: 200, rating: 4.3, image: \"https://loremflickr.com/400/220/zoo,india?lock=110\" },\n  /* \u2500\u2500\u2500 USA \u2500\u2500\u2500 */\n  { name: \"Central Park Zoo\", city:\"New York\", country: \"USA\", lat: 40.77, lng: -73.97, animals: 180, rating: 4.6, image: \"https://loremflickr.com/400/220/zoo,park?lock=201\" },\n  { name: \"San Diego Zoo\", city:\"San Diego\", country: \"USA\", lat: 32.74, lng: -117.15, animals: 650, rating: 4.9, image: \"https://loremflickr.com/400/220/zoo,animals?lock=202\" },\n  { name: \"Smithsonian National Zoo\", city:\"Washington D.C.\", country: \"USA\", lat: 38.93, lng: -77.05, animals: 410, rating: 4.8, image: \"https://loremflickr.com/400/220/zoo,panda?lock=203\" },\n  { name: \"Bronx Zoo\", city:\"New York\", country: \"USA\", lat: 40.85, lng: -73.88, animals: 500, rating: 4.7, image: \"https://loremflickr.com/400/220/zoo,gorilla?lock=204\" },\n  { name: \"Houston Zoo\", city:\"Houston\", country: \"USA\", lat: 29.71, lng: -95.39, animals: 300, rating: 4.5, image: \"https://loremflickr.com/400/220/zoo,elephant?lock=205\" },\n  { name: \"Los Angeles Zoo\", city:\"Los Angeles\", country: \"USA\", lat: 34.15, lng: -118.29, animals: 270, rating: 4.4, image: \"https://loremflickr.com/400/220/zoo,california?lock=206\" },\n  { name: \"Chicago Lincoln Park Zoo\", city:\"Chicago\", country: \"USA\", lat: 41.92, lng: -87.63, animals: 200, rating: 4.5, image: \"https://loremflickr.com/400/220/zoo,chicago?lock=207\" },\n  { name: \"San Diego Safari Park\", city:\"Escondido\", country: \"US