 rtdbSet(userOnlineRef, null).catch(() => {}); };\n   119\u2192  }, [user?.uid]);\n   120\u2192\n   121\u2192  function trackReelView(reelId) {\n   122\u2192    if (!reelId || !user?.uid) return;\n   123\u2192    if (reelId.startsWith(\"ff\") || reelId.startsWith(\"dr\") || reelId.startsWith(\"du\") || reelId.startsWith(\"fu\")) return;\n   124\u2192    const viewRef = ref(rtdb, `live-views/${reelId}`);\n   125\u2192    rtdbSet(viewRef, (liveViews[reelId] || 0) + 1).catch(() => {});\n   126\u2192    const trendRef = ref(rtdb, `trending/${reelId}/score`);\n   127\u2192    rtdbSet(trendRef, ((trending.find(t => t.id === reelId)?.score) || 0) + 1).catch(() => {});\n   128\u2192  }\n   129\u2192\n   130\u2192  function likeReelLive(reelId) {\n   131\u2192    if (!reelId || !user?.uid) return;\n   132\u2192    const likeRef = ref(rtdb, `live-likes/${reelId}`);\n   133\u2192    rtdbSet(likeRef, Date.now()).catch(() => {});\n   134\u2192  }\n   135\u2192\n   136\u2192  async function loadUserLikes(uid) {\n   137\u2192    try {\n   138\u2192      const snap = await getDoc(doc(db, \"userLikes\", uid));\nReview the changes and make sure they are as expected (correct indentation, no duplicate lines, etc). Edit the file again if necessary."}]}, {"role": "tool", "content": [{"type": "text", "text": "Command executed successfully.\nThere was no output."}]}]}
