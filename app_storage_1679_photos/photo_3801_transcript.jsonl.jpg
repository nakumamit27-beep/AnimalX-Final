{"memory_id": 338, "messages": [{"role": "assistant", "content": [{"type": "text", "text": "Let me fix the permission flood and write all the CSS in one big parallel batch:"}]}, {"role": "assistant", "content": [], "tool_calls": [{"type": "tool", "name": "edit", "arguments": {"file_path": "artifacts/animal-x/src/context/SocialContext.jsx", "old_string": "  function trackReelView(reelId) {\n    if (!reelId) return;\n    const viewRef = ref(rtdb, `live-views/${reelId}`);\n    rtdbSet(viewRef, (liveViews[reelId] || 0) + 1).catch(() => {});\n    const trendRef = ref(rtdb, `trending/${reelId}/score`);\n    rtdbSet(trendRef, ((trending.find(t => t.id === reelId)?.score) || 0) + 1).catch(() => {});\n  }\n\n  function likeReelLive(reelId) {\n    if (!reelId) return;\n    const likeRef = ref(rtdb, `live-likes/${reelId}`);\n    rtdbSet(likeRef, Date.now()).catch(() => {});\n  }", "new_string": "  function trackReelView(reelId) {\n    if (!reelId || !user?.uid) return;\n    if (reelId.startsWith(\"ff\") || reelId.startsWith(\"dr\") || reelId.startsWith(\"du\") || reelId.startsWith(\"fu\")) return;\n    const viewRef = ref(rtdb, `live-views/${reelId}`);\n    rtdbSet(viewRef, (liveViews[reelId] || 0) + 1).catch(() => {});\n    const trendRef = ref(rtdb, `trending/${reelId}/score`);\n    rtdbSet(trendRef, ((trending.find(t => t.id === reelId)?.score) || 0) + 1).catch(() => {});\n  }\n\n  function likeReelLive(reelId) {\n    if (!reelId || !user?.uid) return;\n    const likeRef = ref(rtdb, `live-likes/${reelId}`);\n    rtdbSet(likeRef, Date.now()).catch(() => {});\n  }"}}, {"type": "tool", "name": "bash", "arguments": {"command": "cat >> artifacts/animal-x/src/styles/app.css << 'CSSEOF'\n\n/* ===================================================================\n   REELS PAGE \u2014 TikTok-style full-screen snap scroll\n   =================================================================== */\n.reels-page {\n  height: calc(100dvh - var(--nav-h) - 64px); /* top bar + bottom nav */\n  display: flex;\n  flex-direction: column;\n  background: #000;\n  overflow: hidden;\n  position: relative;\n}\n\n.reels-top-bar {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 10px 16px;\n  background: rgba(0,0,0,0.7);\n  backdrop-filter: blur(8px);\n  z-index: 10;\n}\n.reels-top-title {\n  font-size: 1.1rem;\n  font-weight: 700;\n  color: #fff;\n}\n.reels-upload-btn {\n  background: linear-gradient(135deg, #22c55e, #16a34a);\n  color: #000;\n  border: none;\n  padding: 6px 14px;\n  border-radius: 20px;\n  font-weight: 700;\n  font-size: 0.85rem;\n  cursor: pointer;\n  transition: transform 0.15s;\n}\n.reels-upload-btn:hover { transform: scale(1.05); }\n\n.reels-top-actions { display: flex; align-items: center; gap: 10px; }\n\n.reels-cat-bar {\n  flex-shrink: 0;\n  display: flex;\n  gap: 8px;\n  overflow-x: auto;\n  padding: 8px 12px;\n  scrollbar-width: none;\n  background: rgba(0,0,0,0.5);\n}\n.reels-cat-bar::-webkit-scrollbar { display: none; }\n\n.reel-cat-pill {\n  flex-shrink: 0;\n  padding: 4px 14px;\n  border-radius: 20px;\n  border: 1px solid rgba(255,255,255,0.25);\n  background: rgba(255,255,255,0.08);\n  color: rgba(255,255,255,0.7);\n  font-size: 0.78rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s;\n  white-space: nowrap;\n}\n.reel-cat-pill.active {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #000;\n}\n\n/* Snap scroll container */\n.reels-scroll {\n  flex: 1;\n  overflow-y: scroll;\n  scroll-snap-type: y mandatory;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n  min-height: 0;\n}\n.reels-scroll::-webkit-scrollbar { display: none; }\n\n/* Individual reel card */\n.reel-item {\n  height: 100%;\n  scroll-snap-align: start;\n  scroll-snap-stop: always;\n  position: relative;\n  background: #111;\n  overflow: hidden;\n  flex-shrink: 0;\n}\n\n/* Video element */\n.reel-video {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* Demo gradient background */\n.reel-demo-bg {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.reel-demo-emoji {\n  font-size: clamp(5rem, 18vw, 9rem);\n  filter: drop-shadow(0 8px 32px rgba(0,0,0,0.5));\n  animation: reel-float 3s ease-in-out infinite;\n}\n@keyframes reel-float {\n  0%,100% { transform: translateY(0); }\n  50% { transform: translateY(-12px); }\n}\n\n/* Bottom gradient overlay */\n.reel-gradient-overlay {\n  position: absolute;\n  bottom: 0; left: 0; right: 0;\n  height: 65%;\n  background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.5) 50%, transparent 100%);\n  pointer-events: none;\n}\n\n/* Sponsored badge */\n.reel-sponsored-tag {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  background: rgba(0,0,0,0.7);\n  color: #fbbf24;\n  font-size: 0.7rem;\n  font-weight: 700;\n  padding: 3px 10px;\n  border-radius: 12px;\n  border: 1px solid rgba(251,191,36,0.4);\n  z-index: 5;\n}\n\n/* Bottom-left overlay info */\n.reel-overlay-bottom {\n  position: absolute;\n  bottom: 20px;\n  left: 14px;\n  right: 80px;\n  z-index: 5;\n}\n.reel-creator-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 8px;\n}\n.reel-avatar {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, var(--accent), #0284c7);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.3rem;\n  border: 2px solid rgba(255,255,255,0.8);\n  flex-shrink: 0;\n  text-decoration: none;\n}\n.reel-creator-info { flex: 1; min-width: 0; }\n.reel-username-link {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  color: #fff;\n  font-weight: 700;\n  font-size: 0.88rem;\n  text-decoration: none;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.reel-follow-btn {\n  flex-shrink: 0;\n  padding: 5px 14px;\n  border-radius: 20px;\n  border: 1.5px solid #fff;\n  background: transparent;\n  color: #fff;\n  font-size: 0.78rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n.reel-follow-btn.following {\n  background: rgba(255,255,255,0.2);\n  border-color: rgba(255,255,255,0.5);\n}\n.reel-title {\n  color: #fff;\n  font-size: 0.92rem;\n  font-weight: 700;\n  margin-bottom: 4px;\n  line-height: 1.3;\n}\n.reel-desc {\n  color: rgba(255,255,255,0.8);\n  font-size: 0.78rem;\n  line-height: 1.4;\n  margin-bottom: 6px;\n}\n.reel-hashtags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 6px;\n}\n.reel-hashtag {\n  color: #7dd3fc;\n  font-size: 0.75rem;\n  font-weight: 600;\n}\n.reel-meta-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  color: rgba(255,255,255,0.65);\n  font-size: 0.72rem;\n}\n.reel-cat-badge {\n  background: rgba(34,197,94,0.25);\n  color: #4ade80;\n  padding: 2px 8px;\n  border-radius: 10px;\n  font-size: 0.7rem;\n  font-weight: 700;\n}\n\n/* Right-side action buttons */\n.reel-actions-right {\n  position: absolute;\n  right: 12px;\n  bottom: 20px;\n  z-index: 6;\n}\n.reel-action-col {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n}\n.reel-action-btn {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 3px;\n  background: none;\n  border: none;\n  cursor: pointer;\n  color: #fff;\n  transition: transform 0.15s;\n}\n.reel-action-btn:hover { transform: scale(1.15); }\n.reel-action-btn.liked .reel-action-icon { filter: drop-shadow(0 0 6px #ef4444); }\n.reel-action-btn.saved .reel-action-icon { filter: drop-shadow(0 0 6px #fbbf24); }\n.reel-action-btn.danger-btn .reel-action-icon { opacity: 0.7; }\n.reel-action-icon { font-size: 1.6rem; line-height: 1; }\n.reel-action-count {\n  font-size: 0.68rem;\n  font-weight: 700;\n  color: rgba(255,255,255,0.9);\n  text-shadow: 0 1px 3px rgba(0,0,0,0.8);\n}\n\n/* Heart burst animation */\n.reel-heart-burst {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n  z-index: 20;\n  font-size: 5rem;\n  animation: heart-burst 0.8s ease-out forwards;\n}\n@keyframes heart-burst {\n  0%   { transform: scale(0); opacity: 0; }\n  30%  { transform: scale(1.4); opacity: 1; }\n  60%  { transform: scale(1); opacity: 1; }\n  100% { transform: scale(1.2); opacity: 0; }\n}\n\n/* Empty state */\n.reels-empty {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  color: rgba(255,255,255,0.7);\n  text-align: center;\n}\n\n/* ===================================================================\n   COMMENTS PANEL\n   =================================================================== */\n.comments-backdrop {\n  position: fixed;\n  inset: 0;\n  background: rgba(0,0,0,0.6);\n  z-index: 400;\n  display: flex;\n  align-items: flex-end;\n}\n\n.comments-panel {\n  width: 100%;\n  max-height: 75vh;\n  background: var(--bg2);\n  border-radius: 20px 20px 0 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  animation: panel-slide-up 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n@keyframes panel-slide-up {\n  from { transform: translateY(100%); }\n  to   { transform: translateY(0); }\n}\n\n.comments-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 18px 10px;\n  border-bottom: 1px solid var(--border);\n  flex-shrink: 0;\n}\n.comments-title { font-weight: 700; font-size: 1rem; }\n.comments-close {\n  background: var(--bg3);\n  border: none;\n  color: var(--text);\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  cursor: pointer;\n  font-size: 1rem;\n}\n\n.comments-reel-preview {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 18px;\n  background: var(--bg3);\n  border-bottom: 1px solid var(--border);\n  flex-shrink: 0;\n}\n.crp-emoji { font-size: 1.8rem; }\n.crp-title { font-weight: 600; font-size: 0.85rem; }\n.crp-author { color: var(--text2); font-size: 0.75rem; }\n\n.comments-list {\n  flex: 1;\n  overflow-y: auto;\n  padding: 12px 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.comments-empty {\n  text-align: center;\n  color: var(--text2);\n  padding: 32px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n}\n\n.comment-item {\n  display: flex;\n  gap: 10px;\n  align-items: flex-start;\n}\n.comment-avatar {\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, var(--accent), #0ea5e9);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.9rem;\n  font-weight: 700;\n  flex-shrink: 0;\n  color: #000;\n}\n.comment-body { flex: 1; }\n.comment-username {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-weight: 700;\n  font-size: 0.82rem;\n  color: var(--accent);\n  margin-bottom: 3px;\n}\n.comment-time { color: var(--text2); font-size: 0.72rem; font-weight: 400; margin-left: 4px; }\n.comment-text { font-size: 0.88rem; line-height: 1.4; color: var(--text); }\n.comment-delete {\n  background: none;\n  border: none;\n  cursor: pointer;\n  font-size: 0.85rem;\n  opacity: 0.5;\n  padding: 2px 4px;\n}\n.comment-delete:hover { opacity: 1; }\n\n.comment-input-row {\n  display: flex;\n  gap: 10px;\n  padding: 12px 14px;\n  border-top: 1px solid var(--border);\n  flex-shrink: 0;\n  padding-bottom: max(12px, env(safe-area-inset-bottom));\n}\n.comment-input {\n  flex: 1;\n  background: var(--bg3);\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  color: var(--text);\n  padding: 8px 14px;\n  font-size: 0.88rem;\n  outline: none;\n}\n.comment-input:focus { border-color: var(--accent); }\n.comment-submit {\n  background: var(--accent);\n  color: #000;\n  border: none;\n  border-radius: 20px;\n  padding: 8px 16px;\n  font-weight: 700;\n  cursor: pointer;\n  font-size: 0.85rem;\n}\n.comment-submit:disabled { opacity: 0.4; cursor: not-allowed; }\n\n/* ===================================================================\n   UPLOAD REEL MODAL\n   =================================================================== */\n.upload-modal-backdrop {\n  position: fixed;\n  inset: 0;\n  background: rgba(0,0,0,0.7);\n  z-index: 500;\n  display: flex;\n  align-items: flex-end;\n}\n@media (min-width: 600px) {\n  .upload-modal-backdrop { align-items: center; justify-content: center; }\n}\n\n.upload-modal {\n  width: 100%;\n  max-width: 540px;\n  max-height: 92vh;\n  background: var(--bg2);\n  border-radius: 20px 20px 0 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  animation: panel-slide-up 0.3s ease;\n}\n@media (min-width: 600px) {\n  .upload-modal { border-radius: 20px; max-height: 85vh; }\n}\n\n.upload-modal-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--border);\n  flex-shrink: 0;\n}\n.upload-modal-steps {\n  display: flex;\n  gap: 6px;\n}\n.upload-step {\n  width: 26px; height: 26px;\n  border-radius: 50%;\n  border: 2px solid var(--border);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 0.78rem; font-weight: 700;\n  color: var(--text2);\n}\n.upload-step.active { border-color: var(--accent); color: var(--accent); }\n.upload-step.done { border-color: var(--accent); background: var(--accent); color: #000; }\n.upload-modal-title { flex: 1; font-weight: 700; font-size: 0.95rem; }\n.upload-modal-close {\n  background: var(--bg3); border: none; color: var(--text);\n  width: 30px; height: 30px; border-radius: 50%; cursor: pointer;\n}\n\n.upload-error {\n  margin: 10px 16px;\n  padding: 10px 14px;\n  background: rgba(239,68,68,0.15);\n  border: 1px solid rgba(239,68,68,0.4);\n  border-radius: 10px;\n  color: #fca5a5;\n  font-size: 0.85rem;\n}\n.upload-warning {\n  margin: 10px 16px;\n  padding: 12px 14px;\n  background: rgba(245,158,11,0.15);\n  border: 1px solid rgba(245,158,11,0.4);\n  border-radius: 10px;\n  color: #fcd34d;\n  font-size: 0.85rem;\n  line-height: 1.5;\n}\n.upload-warning-revise, .upload-warning-proceed {\n  padding: 6px 14px; border-radius: 8px; border: none; cursor: pointer;\n  font-size: 0.8rem; font-weight: 700;\n}\n.upload-warning-revise { background: var(--bg3); color: var(--text); }\n.upload-warning-proceed { background: rgba(239,68,68,0.3); color: #fca5a5; }\n.upload-banned-msg {\n  margin: 16px; padding: 14px;\n  background: rgba(239,68,68,0.2); border: 1px solid rgba(239,68,68,0.5);\n  border-radius: 12px; color: #fca5a5; font-weight: 600; text-align: center;\n}\n\n.upload-form {\n  flex: 1;\n  overflow-y: auto;\n  padding: 14px 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.upload-label { font-size: 0.8rem; font-weight: 700; color: var(--text2); }\n.upload-input {\n  width: 100%;\n  background: var(--bg3);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  color: var(--text);\n  padding: 9px 12px;\n  font-size: 0.88rem;\n  outline: none;\n}\n.upload-input:focus { border-color: var(--accent); }\n.upload-textarea {\n  width: 100%;\n  background: var(--bg3);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  color: var(--text);\n  padding: 9px 12px;\n  font-size: 0.88rem;\n  outline: none;\n  resize: vertical;\n}\n.upload-textarea:focus { border-color: var(--accent); }\n.upload-select {\n  width: 100%;\n  background: var(--bg3);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  color: var(--text);\n  padding: 9px 12px;\n  font-size: 0.88rem;\n  outline: none;\n}\n.upload-moderation-note {\n  font-size: 0.75rem;\n  color: var(--text2);\n  background: rgba(34,197,94,0.08);\n  border: 1px solid rgba(34,197,94,0.2);\n  border-radius: 8px;\n  padding: 8px 12px;\n  margin-top: 4px;\n}\n\n.upload-video-step {\n  flex: 1; overflow-y: auto; padding: 14px 16px;\n  display: flex; flex-direction: column; gap: 12px;\n}\n.upload-drop-zone {\n  border: 2px dashed var(--border);\n  border-radius: 16px;\n  min-height: 200px;\n  display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  gap: 12px; cursor: pointer;\n  background: var(--bg3);\n  transition: border-color 0.2s;\n}\n.upload-drop-zone:hover { border-color: var(--accent); }\n.upload-drop-text { font-weight: 700; font-size: 1rem; }\n.upload-drop-hint { color: var(--text2); font-size: 0.8rem; }\n.upload-preview-video {\n  width: 100%; height: 200px; object-fit: contain; border-radius: 12px;\n}\n.upload-file-info {\n  color: var(--accent); font-size: 0.82rem; font-weight: 600;\n  background: rgba(34,197,94,0.1); border-radius: 8px; padding: 8px 12px;\n}\n.upload-thumb-row { display: flex; flex-direction: column; gap: 6px; }\n.upload-thumb-btn {\n  padding: 8px 14px; border-radius: 10px;\n  border: 1px solid var(--border); background: var(--bg3);\n  color: var(--text); cursor: pointer; font-size: 0.85rem;\n}\n\n.upload-review-step {\n  flex: 1; overflow-y: auto; padding: 14px 16px;\n  display: flex; flex-direction: column; gap: 14px;\n}\n.upload-review-card {\n  display: flex; gap: 14px; align-items: center;\n  background: var(--bg3); border-radius: 12px; padding: 14px;\n}\n.upload-review-emoji { font-size: 2.5rem; }\n.upload-review-title { font-weight: 700; font-size: 0.95rem; }\n.upload-review-cat { color: var(--accent); font-size: 0.82rem; margin-top: 4px; }\n.upload-review-tags { color: #7dd3fc; font-size: 0.78rem; margin-top: 4px; }\n.upload-review-file { color: var(--text2); font-size: 0.75rem; margin-top: 4px; }\n\n.upload-guidelines {\n  background: rgba(34,197,94,0.06);\n  border: 1px solid rgba(34,197,94,0.2);\n  border-radius: 12px; padding: 14px;\n}\n.upload-guidelines-title { font-weight: 700; font-size: 0.88rem; margin-bottom: 10px; }\n.upload-guidelines ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }\n.upload-guidelines li { font-size: 0.82rem; color: var(--text2); }\n\n.upload-progress-wrap {\n  background: var(--bg3); border-radius: 8px; padding: 12px; position: relative; overflow: hidden;\n}\n.upload-progress-bar {\n  position: absolute; top: 0; left: 0; height: 100%;\n  background: linear-gradient(90deg, var(--accent), #0ea5e9);\n  transition: width 0.3s ease; opacity: 0.3;\n}\n.upload-progress-text {\n  position: relative; z-index: 1; font-weight: 700; font-size: 0.85rem; text-align: center;\n}\n\n.upload-modal-footer {\n  display: flex; gap: 10px; padding: 12px 16px;\n  border-top: 1px solid var(--border); flex-shrink: 0;\n  padding-bottom: max(12px, env(safe-area-inset-bottom));\n}\n.upload-back-btn {\n  padding: 10px 16px; border-radius: 10px;\n  border: 1px solid var(--border); background: var(--bg3);\n  color: var(--text); cursor: pointer; font-weight: 600;\n}\n.upload-next-btn, .upload-post-btn {\n  flex: 1; padding: 10px 16px; border-radius: 10px;\n  border: none; background: var(--accent);\n  color: #000; cursor: pointer; font-weight: 700; font-size: 0.95rem;\n}\n.upload-post-btn:disabled { opacity: 0.5; cursor: not-allowed; }\n\n/* ===================================================================\n   SEARCH PAGE \u2014 Enhanced\n   =================================================================== */\n.search-page {\n  min-height: 100%;\n  background: var(--bg);\n  padding-bottom: 80px;\n}\n.search-header {\n  display: flex; align-items: center; gap: 10px;\n  padding: 12px 16px;\n  background: var(--bg2);\n  border-bottom: 1px solid var(--border);\n  position: sticky; top: 0; z-index: 10;\n}\n.search-back-btn {\n  background: var(--bg3); border: 1px solid var(--border);\n  color: var(--text); border-radius: 10px;\n  padding: 8px 12px; cursor: pointer; font-size: 1rem;\n}\n.search-input-wrap {\n  flex: 1; display: flex; align-items: center;\n  background: var(--bg3); border: 1px solid var(--border);\n  border-radius: 12px; padding: 0 12px; gap: 8px;\n}\n.search-input-wrap:focus-within { border-color: var(--accent); }\n.search-icon-inner { color: var(--text2); font-size: 1rem; }\n.search-main-input {\n  flex: 1; background: none; border: none;\n  color: var(--text); padding: 10px 0;\n  font-size: 0.95rem; outline: none;\n}\n.search-clear-btn {\n  background: none; border: none; color: var(--text2);\n  cursor: pointer; font-size: 0.9rem; padding: 4px;\n}\n\n.search-filter-row {\n  padding: 10px 14px 6px;\n  border-bottom: 1px solid var(--border);\n}\n.search-cats {\n  display: flex; gap: 8px;\n  overflow-x: auto; scrollbar-width: none;\n  padding-bottom: 8px;\n}\n.search-cats::-webkit-scrollbar { display: none; }\n.search-cat-pill {\n  flex-shrink: 0; padding: 5px 12px; border-radius: 20px;\n  border: 1px solid var(--border); background: var(--bg3);\n  color: var(--text2); font-size: 0.78rem; font-weight: 600;\n  cursor: pointer; white-space: nowrap; transition: all 0.2s;\n}\n.search-cat-pill.active {\n  background: rgba(34,197,94,0.15); border-color: var(--accent); color: var(--accent);\n}\n\n.search-sort-row {\n  display: flex; align-items: center; gap: 8px; padding-top: 6px;\n}\n.search-sort-label { font-size: 0.8rem; color: var(--text2); }\n.search-sort-sel {\n  background: var(--bg3); border: 1px solid var(--border);\n  color: var(--text); border-radius: 8px; padding: 4px 8px;\n  font-size: 0.8rem; cursor: pointer;\n}\n\n.search-results-count {\n  padding: 8px 16px;\n  font-size: 0.8rem; color: var(--text2);\n}\n\n.search-results {\n  display: flex; flex-direction: column; gap: 0;\n}\n.search-user-card {\n  display: flex; align-items: center;\n  padding: 12px 16px; gap: 12px;\n  border-bottom: 1px solid var(--border);\n  transition: background 0.15s;\n}\n.search-user-card:hover { background: var(--bg3); }\n.search-user-main {\n  display: flex; gap: 12px; align-items: center;\n  flex: 1; min-width: 0; text-decoration: none; color: inherit;\n}\n.search-user-avatar {\n  width: 52px; height: 52px; border-radius: 50%;\n  background: linear-gradient(135deg, var(--accent), #0ea5e9);\n  display: flex; 