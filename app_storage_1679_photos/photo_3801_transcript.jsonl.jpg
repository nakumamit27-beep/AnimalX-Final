2          <div className=\"profile-grid-empty\">\n   443\u2192            <div style={{ fontSize: 48 }}>\ud83c\udff7\ufe0f</div>\n   444\u2192            <p>No one has tagged you yet.</p>\n   445\u2192          </div>\n   446\u2192        )}\n   447\u2192      </div>\n   448\u2192\n   449\u2192      {adminMode && isSuperAdmin && (\n   450\u2192        <div className=\"admin-panel\">\n   451\u2192          <div className=\"admin-header\">\n   452\u2192            <h2>\ud83d\udc51 Admin Panel</h2>\n   453\u2192            <button className=\"qs-pill\" onClick={lockAdminMode}>Lock Admin Mode</button>\n   454\u2192          </div>\n   455\u2192\n   456\u2192          <div className=\"admin-section\">\n   457\u2192            <h3>\u2795 Add New Animal</h3>\n   458\u2192            <div className=\"aef-row\">\n   459\u2192              <label>Name *</label>\n   460\u2192              <input\n   461\u2192                type=\"text\"\n   462\u2192                placeholder=\"e.g. Spirit Lion\"\n   463\u2192                value={newName}\n   464\u2192                onChange={(e) => setNewName(e.target.value)}\n   465\u2192              />\n   466\u2192            </div>\n   467\u2192            <div className=\"aef-row\">\n   468\u2192              <label>Category</label>\n   469\u2192              <select\n   470\u2192                value={newCategory}\n   471\u2192                onChange={(e) => setNewCategory(e.target.value)}\n   472\u2192                className=\"admin-input\"\n   473\u2192                style={{ width: \"100%\" }}\n   474\u2192              >\n   475\u2192                {categories.map((c) => <option key={c} value={c}>{c}</option>)}\n   476\u2192              </select>\n   477\u2192            </div>\n   478\u2192            <div className=\"aef-row\">\n   479\u2192              <label>Image</label>\n   480\u2192              <input\n   481\u2192                ref={photoFileRef}\n   482\u2192                type=\"file\"\n   483\u2192                accept=\"image/*\"\n   484\u2192                onChange={handleNewAnimalImage}\n   485\u2192              />\n   486\u2192              {newImage && (\n   487\u2192                <img\n   488\u2192                  src={newImage}\n   489\u2192                  alt=\"preview\"\n   490\u2192                  style={{ marginTop: 8, maxWidth: 160, borderRadius: 8, border: \"2px solid var(--accent)\" }}\n   491\u2192                />\n   492\u2192              )}\n   493\u2192            </div>\n   494\u2192            <div className=\"aef-row\">\n   495\u2192              <label>Habits / Habitat</label>\n   496\u2192              <textarea\n   497\u2192                rows={2}\n   498\u2192                placeholder=\"e.g. Nocturnal apex predator that lives in prides...\"\n   499\u2192                value={newHabits}\n   500\u2192                onChange={(e) => setNewHabits(e.target.value)}\n   501\u2192              />\n   502\u2192            </div>\n   503\u2192            <div className=\"aef-row\">\n   504\u2192              <label>Lifespan</label>\n   505\u2192              <input\n   506\u2192                type=\"text\"\n   507\u2192                placeholder=\"e.g. 12\u201316 years wild\"\n   508\u2192                value={newLifespan}\n   509\u2192                onChange={(e) => setNewLifespan(e.target.value)}\n   510\u2192              />\n   511\u2192            </div>\n   512\u2192            <div className=\"aef-row\">\n   513\u2192              <label>Country / Region</label>\n   514\u2192              <input\n   515\u2192                type=\"text\"\n   516\u2192                placeholder=\"e.g. Kenya\"\n   517\u2192                value={newCountry}\n   518\u2192                onChange={(e) => setNewCountry(e.target.value)}\n   519\u2192              />\n   520\u2192            </div>\n   521\u2192            <button className=\"btn-primary\" onClick={submitNewAnimal}>\n   522\u2192              \u2713 Add Animal to App\n   523\u2192            </button>\n   524\u2192            {customAnimals.length > 0 && (\n   525\u2192              <div style={{ marginTop: 16 }}>\n   526\u2192                <p className=\"admin-hint\">Custom animals you've added ({customAnimals.length}):</p>\n   527\u2192                <div className=\"custom-animals-list\">\n   528\u2192                  {customAnimals.map((a) => (\n   529\u2192                    <div key={a.id} className=\"custom-animal-row\">\n   530\u2192                      {a.image\n   531\u2192                        ? <img src={a.image} alt={a.name} className=\"ca-thumb\" />\n   532\u2192                        : <div className=\"ca-thumb ca-thumb-empty\">\ud83d\udc3e</div>}\n   533\u2192                      <div className=\"ca-info\">\n   534\u2192                        <div className=\"ca-name\">{a.name}</div>\n   535\u2192                        <div className=\"ca-meta\">{a.category} \u00b7 {a.country}</div>\n   536\u2192                      </div>\n   537\u2192                      <button className=\"qs-pill qs-logout\" onClick={() => removeCustom(a.id, a.name)}>\u2715</button>\n   538\u2192                    </div>\n   539\u2192                  ))}\n   540\u2192                </div>\n   541\u2192              </div>\n   542\u2192            )}\n   543\u2192          </div>\n   544\u2192\n   545\u2192          <div className=\"admin-section\">\n   546\u2192            <h3>\ud83d\udcc8 Follower Booster</h3>\n   547\u2192            <div className=\"admin-row\">\n   548\u2192              <input\n   549\u2192                type=\"text\"\n   550\u2192                placeholder=\"e.g. 50k, 1M, 250000\"\n   551\u2192                value={followersInput}\n   552\u2192                onChange={(e) => setFollowersInput(e.target.value)}\n   553\u2192                className=\"admin-input\"\n   554\u2192              />\n   555\u2192              <button className=\"btn-primary\" onClick={applyFollowers}>Set Followers</button>\n   556\u2192            </div>\n   557\u2192            <p className=\"admin-hint\">Current: <b>{formatCount(profile.followers)}</b> \u00b7 Auto-verifies at 100K.</p>\n   558\u2192\n   559\u2192            <label className=\"admin-toggle\">\n   560\u2192              <input\n   561\u2192                type=\"checkbox\"\n   562\u2192                checked={!!profile.autoGrow}\n   563\u2192                onChange={(e) => updateProfile({ autoGrow: e.target.checked })}\n   564\u2192              />\n   565\u2192              <span>Auto-grow followers (+5\u201310 per app start)</span>\n   566\u2192            </label>\n   567\u2192\n   568\u2192            <label className=\"admin-toggle\">\n   569\u2192              <input\n   570\u2192                type=\"checkbox\"\n   571\u2192                checked={!!profile.manualVerified}\n   572\u2192                onChange={(e) => updateProfile({ manualVerified: e.target.checked })}\n   573\u2192              />\n   574\u2192              <span>\ud83d\udd35 Manual Blue Tick (override)</span>\n   575\u2192            </label>\n   576\u2192          </div>\n   577\u2192\n   578\u2192          <div className=\"admin-section\">\n   579\u2192            <h3>\ud83d\udcca Manual Stats</h3>\n   580\u2192            <div className=\"admin-row\">\n   581\u2192              <input type=\"number\" placeholder=\"Posts count\" value={postsInput} onChange={(e) => setPostsInput(e.target.value)} className=\"admin-input\" />\n   582\u2192              <button className=\"btn-primary\" onClick={applyPosts}>Set Posts</button>\n   583\u2192            </div>\n   584\u2192            <div className=\"admin-row\">\n   585\u2192              <input type=\"number\" placeholder=\"Reels count\" value={reelsInput} onChange={(e) => setReelsInput(e.target.value)} className=\"admin-input\" />\n   586\u2192              <button className=\"btn-primary\" onClick={applyReels}>Set Reels</button>\n   587\u2192            </div>\n   588\u2192          </div>\n   589\u2192\n   590\u2192          <div className=\"admin-section\">\n   591\u2192            <h3>\ud83d\udc65 User Management</h3>\n   592\u2192            <input\n   593\u2192              type=\"search\"\n   594\u2192              placeholder=\"Search by name, email, or UID\"\n   595\u2192              value={search}\n   596\u2192              onChange={(e) => setSearch(e.target.value)}\n   597\u2192              className=\"admin-input\"\n   598\u2192              style={{ width: \"100%\" }}\n   599\u2192            />\n   600\u2192            <div className=\"admin-user-list\">\n   601\u2192              {filteredUsers.length === 0 && <p className=\"admin-hint\">No users registered yet.</p>}\n   602\u2192              {filteredUsers.map((u) => {\n   603\u2192                const verified = !!verifiedMap[u.email] || !!verifiedMap[u.uid];\n   604\u2192                return (\n   605\u2192                  <div key={u.uid || u.email} className=\"admin-user-row\">\n   606\u2192                    <div className=\"adm-avatar\">{(u.name || u.email || \"?\")[0].toUpperCase()}</div>\n   607\u2192                    <div className=\"adm-info\">\n   608\u2192                      <div className=\"adm-name\">\n   609\u2192                        {u.name || \"(no name)\"}\n   610\u2192                        {verified && <BlueTick />}\n   611\u2192                      </div>\n   612\u2192                      <div className=\"adm-email\">{u.email}</div>\n   613\u2192                      <div className=\"adm-uid\">UID: {u.uid || \"\u2014\"}</div>\n   614\u2192                    </div>\n   615\u2192                    <div className=\"adm-actions\">\n   616\u2192                      <button className=\"qs-pill\" onClick={() => copyText(u.email)}>Copy Email</button>\n   617\u2192                      <button className=\"qs-pill\" onClick={() => copyText(u.uid || \"\")}>Copy UID</button>\n   618\u2192                      <label className=\"adm-switch\">\n   619\u2192                        <input\n   620\u2192                          type=\"checkbox\"\n   621\u2192                          checked={verified}\n   622\u2192                          onChange={(e) => setVerifiedFor(u.email, e.target.checked)}\n   623\u2192                        />\n   624\u2192                        <span>Verified</span>\n   625\u2192                      </label>\n   626\u2192                    </div>\n   627\u2192                  </div>\n   628\u2192                );\n   629\u2192              })}\n   630\u2192            </div>\n   631\u2192            <p className=\"admin-hint\">Sensitive emails are visible only to the super admin ({SUPER_ADMIN_EMAIL}).</p>\n   632\u2192          </div>\n   633\u2192        </div>\n   634\u2192      )}\n   635\u2192    </div>\n   636\u2192  );\n   637\u2192}"}]}]}
