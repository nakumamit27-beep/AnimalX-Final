ull);\n    30\u2192  const [profile, setProfile] = useState(DEFAULT_PROFILE);\n    31\u2192  const [adminMode, setAdminMode] = useState(false);\n    32\u2192  const [authLoading, setAuthLoading] = useState(true);\n    33\u2192\n    34\u2192  useEffect(() => {\n    35\u2192    const unsub = onAuthStateChanged(auth, async (fbUser) => {\n    36\u2192      if (fbUser) {\n    37\u2192        const u = {\n    38\u2192          uid: fbUser.uid,\n    39\u2192          email: fbUser.email,\n    40\u2192          name: fbUser.displayName || fbUser.email.split(\"@\")[0],\n    41\u2192        };\n    42\u2192        setUser(u);\n    43\u2192        try {\n    44\u2192          const snap = await getDoc(doc(db, \"users\", fbUser.uid));\n    45\u2192          if (snap.exists()) {\n    46\u2192            setProfile({ ...DEFAULT_PROFILE, ...snap.data() });\n    47\u2192          } else {\n    48\u2192            const fresh = {\n    49\u2192              ...DEFAULT_PROFILE,\n    50\u2192              name: u.name,\n    51\u2192              email: u.email,\n    52\u2192              createdAt: serverTimestamp(),\n    53\u2192            };\n    54\u2192            await setDoc(doc(db, \"users\", fbUser.uid), fresh);\n    55\u2192            setProfile(fresh);\n    56\u2192          }\n    57\u2192        } catch {\n    58\u2192          setProfile(DEFAULT_PROFILE);\n    59\u2192        }\n    60\u2192        if (sessionStorage.getItem(\"ax_admin_mode\") === \"true\") setAdminMode(true);\n    61\u2192      } else {\n    62\u2192        setUser(null);\n    63\u2192        setProfile(DEFAULT_PROFILE);\n    64\u2192        setAdminMode(false);\n    65\u2192      }\n    66\u2192      setAuthLoading(false);\n    67\u2192    });\n    68\u2192    return unsub;\n    69\u2192  }, []);\n    70\u2192\n    71\u2192  const isSuperAdmin = !!(user?.email?.toLowerCase() === SUPER_ADMIN_EMAIL);\n    72\u2192  const autoVerified = (profile.followers || 0) >= 100000;\n    73\u2192  const isVerified = !!(profile.manualVerified || autoVerified);\n    74\u2192\n    75\u2192  async function signup(name, email, password) {\n    76\u2192    try {\n    77\u2192      const cred = await createUserWithEmailAndPassword(auth, email, password);\n    78\u2192      await fbUpdateProfile(cred.user, { displayName: name });\n    79\u2192      return true;\n    80\u2192    } catch (err) {\n    81\u2192      const msg =\n    82\u2192        err.code === \"auth/email-already-in-use\" ? \"An account with this email already exists.\" :\n    83\u2192        err.code === \"auth/weak-password\" ? \"Password must be at least 6 characters.\" :\n    84\u2192        err.message || \"Signup failed.\";\n    85\u2192      alert(msg);\n    86\u2192      return false;\n    87\u2192    }\n    88\u2192  }\n    89\u2192\n    90\u2192  async function login(email, password) {\n    91\u2192    try {\n    92\u2192      await signInWithEmailAndPassword(auth, email, password);\n    93\u2192      return true;\n    94\u2192    } catch (err) {\n    95\u2192      const msg =\n    96\u2192        err.code === \"auth/user-not-found\" || err.code === \"auth/wrong-password\" || err.code === \"auth/invalid-credential\"\n    97\u2192          ? \"Incorrect email or password.\" :\n    98\u2192        err.code === \"auth/too-many-requests\" ? \"Too many failed attempts. Please try again later.\" :\n    99\u2192        err.message || \"Login failed.\";\n   100\u2192      alert(msg);\n   101\u2192      return false;\n   102\u2192    }\n   103\u2192  }\n   104\u2192\n   105\u2192  async function logout() {\n   106\u2192    await signOut(auth);\n   107\u2192    sessionStorage.removeItem(\"ax_admin_mode\");\n   108\u2192    setAdminMode(false);\n   109\u2192  }\n   110\u2192\n   111\u2192  async function forgotPassword(email) {\n   112\u2192    await sendPasswordResetEmail(auth, email);\n   113\u2192  }\n   114\u2192\n   115\u2192  async function updateProfile(patch) {\n   116\u2192    setProfile((p) => ({ ...p, ...patch }));\n   117\u2192    if (user?.uid) {\n   118\u2192      try {\n   119\u2192        await updateDoc(doc(db, \"users\", user.uid), patch);\n   120\u2192      } catch {\n   121\u2192        try {\n   122\u2192          await setDoc(doc(db, \"users\", user.uid), patch, { merge: true });\n   123\u2192        } catch {}\n   124\u2192      }\n   125\u2192    }\n   126\u2192  }\n   127\u2192\n   128\u2192  function unlockAdminMode() {\n   129\u2192    if (!isSuperAdmin) {\n   130\u2192      alert(\"Admin mode is restricted to the super admin account.\");\n   131\u2192      return false;\n   132\u2192    }\n   133\u2192    sessionStorage.setItem(\"ax_admin_mode\", \"true\");\n   134\u2192    setAdminMode(true);\n   135\u2192    return true;\n   136\u2192  }\n   137\u2192\n   138\u2192  function lockAdminMode() {\n   139\u2192    sessionStorage.removeItem(\"ax_admin_mode\");\n   140\u2192    setAdminMode(false);\n   141\u2192  }\n   142\u2192\n   143\u2192  function toggleAdminMode() {\n   144\u2192    const next = !adminMode;\n   145\u2192    setAdminMode(next);\n   146\u2192    if (next) sessionStorage.setItem(\"ax_admin_mode\", \"true\");\n   147\u2192    else sessionStorage.removeItem(\"ax_admin_mode\");\n   148\u2192  }\n   149\u2192\n   150\u2192  const verifiedMap = {};\n   151\u2192  function setVerifiedFor() {}\n   152\u2192  function isUserVerified(u) {\n   153\u2192    if (!u) return false;\n   154\u2192    return (u.followers || 0) >= 100000;\n   155\u2192  }\n   156\u2192  function getAllUsers() { return []; }\n   157\u2192\n   158\u2192  return (\n   159\u2192    <AuthContext.Provider value={{\n   160\u2192      user, profile, authLoading, isVerified, isSuperAdmin,\n   161\u2192      adminMode, setAdminMode, toggleAdminMode,\n   162\u2192      unlockAdminMode, lockAdminMode,\n   163\u2192      signup, login, logout, forgotPassword, updateProfile,\n   164\u2192      setVerifiedFor, isUserVerified, getAllUsers,\n   165\u2192      verifiedMap, SUPER_ADMIN_EMAIL,\n   166\u2192    }}>\n   167\u2192      {children}\n   168\u2192    </AuthContext.Provider>\n   169\u2192  );\n   170\u2192}\n   171\u2192\n   172\u2192export function useAuth() {\n   173\u2192  return useContext(AuthContext);\n   174\u2192}\n   175\u2192"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/context/SocialContext.jsx (lines 1-80 of 250)\n     1\u2192import { createContext, useContext, useState, useEffect, useCallback, useRef } from \"react\";\n     2\u2192import {\n     3\u2192  doc, setDoc, getDoc, collection,\n     4\u2192  query, where, onSnapshot, orderBy, limit,\n     5\u2192  serverTimestamp, updateDoc, increment, addDoc,\n     6\u2192} from \"firebase/firestore\";\n     7\u2192import { ref, onValue, set as rtdbSet, onDisconnect } from \"firebase/database\";\n     8\u2192import { db, rtdb } from \"../utils/firebase\";\n     9\u2192import { reportFirebaseError } from \"../components/FirebaseStatusBanner\";\n    10\u2192import { useAuth } from \"./AuthContext\";\n    11\u2192\n    12\u2192function silentCatch(err) {\n    13\u2192  if (err?.code) reportFirebaseError(err.code, \"Firestore\");\n    14\u2192}\n    15\u2192\n    16\u2192const EMPTY_CTX = {\n    17\u2192  likedReels: {}, likeReel: () => Promise.resolve(),\n    18\u2192  following: {}, followUser: () => Promise.resolve(), unfollowUser: () => Promise.resolve(),\n    19\u2192  notifications: [], unreadCount: 0, markAllRead: () => Promise.resolve(),\n    20\u2192  broadcast: null, dismissBroadcast: () => Promise.resolve(),\n    21\u2192  sendBroadcast: () => Promise.resolve(), submitAd: () => Promise.resolve(false),\n    22\u2192  onlineCount: 0, liveViews: {}, trending: [],\n    23\u2192  trackReelView: () => {}, likeReelLive: () => {},\n    24\u2192  autoTickPopup: false, dismissAutoTickPopup: () => {},\n    25\u2192};\n    26\u2192const SocialContext = createContext(EMPTY_CTX);\n    27\u2192\n    28\u2192export function SocialProvider({ children }) {\n    29\u2192  const { user, profile, updateProfile } = useAuth();\n    30\u2192  const [likedReels, setLikedReels] = useState({});\n    31\u2192  const [following, setFollowing] = useState({});\n    32\u2192  const [notifications, setNotifications] = useState([]);\n    33\u2192  const [unreadCount, setUnreadCount] = useState(0);\n    34\u2192  const [broadcast, setBroadcast] = useState(null);\n    35\u2192  const [onlineCount, setOnlineCount] = useState(0);\n    36\u2192  const [liveViews, setLiveViews] = useState({});\n    37\u2192  const [trending, setTrending] = useState([]);\n    38\u2192  const [autoTickPopup, setAutoTickPopup] = useState(false);\n    39\u2192  const prevFollowers = useRef(0);\n    40\u2192\n    41\u2192  /* Auto blue tick at 100K followers */\n    42\u2192  useEffect(() => {\n    43\u2192    if (!user?.uid || !profile) return;\n    44\u2192    const f = profile.followers || 0;\n    45\u2192    if (f >= 100000 && prevFollowers.current < 100000 && !profile.manualVerified && !profile.autoVerifiedAt) {\n    46\u2192      updateProfile({ autoVerifiedAt: Date.now(), manualVerified: true }).catch(() => {});\n    47\u2192      setAutoTickPopup(true);\n    48\u2192    }\n    49\u2192    prevFollowers.current = f;\n    50\u2192  }, [profile?.followers]);\n    51\u2192\n    52\u2192  function dismissAutoTickPopup() { setAutoTickPopup(false); }\n    53\u2192\n    54\u2192  useEffect(() => {\n    55\u2192    if (!user?.uid) {\n    56\u2192      setLikedReels({}); setFollowing({}); setNotifications([]); setUnreadCount(0);\n    57\u2192      return;\n    58\u2192    }\n    59\u2192    const cached = {};\n    60\u2192    try { Object.assign(cached, JSON.parse(localStorage.getItem(`ax_liked_${user.uid}`) || \"{}\")); } catch {}\n    61\u2192    setLikedReels(cached);\n    62\u2192\n    63\u2192    const followCached = {};\n    64\u2192    try { Object.assign(followCached, JSON.parse(localStorage.getItem(`ax_following_${user.uid}`) || \"{}\")); } catch {}\n    65\u2192    setFollowing(followCached);\n    66\u2192\n    67\u2192    loadUserLikes(user.uid);\n    68\u2192    loadUserFollowing(user.uid);\n    69\u2192\n    70\u2192    const notifUnsub = onSnapshot(\n    71\u2192      query(collection(db, \"notifications\"), where(\"targetUid\", \"==\", user.uid), orderBy(\"createdAt\", \"desc\"), limit(30)),\n    72\u2192      (snap) => {\n    73\u2192        const items = snap.docs.map(d => ({ id: d.id, ...d.data() }));\n    74\u2192        setNotifications(items);\n    75\u2192        setUnreadCount(items.filter(n => !n.read).length);\n    76\u2192      },\n    77\u2192      () => {}\n    78\u2192    );\n    79\u2192    return notifUnsub;\n    80\u2192  }, [user?.uid]);"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/data/demoUsers.js\n     1\u2192/* ============================================================\n     2\u2192   DEMO / FAKE USER SEED DATA\n     3\u2192   - 20 original hero creators (du01\u2013du20)\n     4\u2192   - 180 procedurally-generated wildlife users (fu001\u2013fu180)\n     5\u2192   - Total: 200 users\n     6\u2192   - Each fake user: 20 reels \u2192 3600 generated + 26 original = 3626 total\n     7\u2192   ============================================================ */\n     8\u2192\n     9\u2192/* ---------- original 20 hero creators ---------- */\n    10\u2192export const DEMO_USERS = [\n    11\u2192  { id:\"du01\", username:\"wildlion_africa\",   name:\"Leo Mwangi\",       verified:true,  country:\"Kenya\",       bio:\"Chasing sunsets and lions across Maasai Mara \ud83e\udd81\",   avatar:\"\ud83e\udd81\", followers:248000, following:312, reelCount:156 },\n    12\u2192  { id:\"du02\", username:\"ocean_queen_mia\",   name:\"Mia Nakamura\",     verified:true,  country:\"Japan\",       bio:\"Freediver & marine photographer \ud83c\udf0a\",                 avatar:\"\ud83d\udc2c\", followers:412000, following:890, reelCount:203 },\n    13\u2192  { id:\"du03\", username:\"safari_steve\",      name:\"Steve Odhiambo\",   verified:false, country:\"Tanzania\",    bio:\"Guide at Serengeti NP since 2010 \ud83d\udc18\",                avatar:\"\ud83d\udc18\", followers:87000,  following:421, reelCount:89  },\n    14\u2192  { id:\"du04\", username:\"eagle_eye_anya\",    name:\"Anya Petrov\",      verified:true,  country:\"Russia\",      bio:\"Raptor researcher & wildlife cinematographer \ud83e\udd85\",     avatar:\"\ud83e\udd85\", followers:193000, following:201, reelCount:178 },\n    15\u2192  { id:\"du05\", username:\"reptile_realm\",     name:\"Carlos Mendez\",    verified:false, country:\"Brazil\",      bio:\"Herpetologist studying Amazonian reptiles \ud83d\udc0d\",        avatar:\"\ud83d\udc0d\", followers:62000,  following:543, reelCount:67  },\n    16\u2192  { id:\"du06\", username:\"wolf_tracker_nw\",   name:\"Nathan Wolf\",      verified:true,  country:\"Canada\",      bio:\"Wolf pack researcher in Yellowstone \ud83d\udc3a\",              avatar:\"\ud83d\udc3a\", followers:314000, following:278, reelCount:215 },\n    17\u2192  { id:\"du07\", username:\"birdwatch_bella\",   name:\"Isabella Ferraro\", verified:false, country:\"Italy\",       bio:\"Birding across 80 countries \ud83e\udd9c\",                     avatar:\"\ud83e\udd9c\", followers:58000,  following:1200,reelCount:44  },\n    18\u2192  { id:\"du08\", username:\"deep_sea_divers\",   name:\"Marco Torres\",     verified:true,  country:\"Philippines\", bio:\"Coral restoration diver \ud83e\udeb8\",                         avatar:\"\ud83d\udc20\", followers:221000, following:339, reelCount:132 },\n    19\u2192  { id:\"du09\", username:\"savanna_stories\",   name:\"Amara Diallo\",     verified:false, country:\"Senegal\",     bio:\"African wildlife storyteller & blogger \ud83c\udf0d\",           avatar:\"\ud83e\udd92\", followers:94000,  following:678, reelCount:71  },\n    20\u2192  { id:\"du10\", username:\"polar_explorer_k\",  name:\"Katja Lund\",       verified:true,  country:\"Norway\",      bio:\"Arctic wildlife guide & polar bear researcher \u2744\ufe0f\",    avatar:\"\ud83d\udc3b\u200d\u2744\ufe0f\", followers:376000, following:156, reelCount:244 },\n    21\u2192  { id:\"du11\", username:\"jungle_nat\",        name:\"Natalia Cruz\",     verified:false, country:\"Colombia\",    bio:\"Amazon jungle guide & tree frog enthusiast \ud83d\udc38\",       avatar:\"\ud83d\udc38\", followers:41000,  following:820, reelCount:38  },\n    22\u2192  { id:\"du12\", username:\"desertdog_ali\",     name:\"Ali Hassan\",       verified:false, country:\"UAE\",         bio:\"Desert fox tracker & dune photographer \ud83e\udd8a\",           avatar:\"\ud83e\udd8a\", followers:73000,  following:412, reelCount:56  },\n    23\u2192  { id:\"du13\", username:\"sky_ranger_tom\",    name:\"Tom Eriksen\",      verified:true,  country:\"Sweden\",      bio:\"Drone cinematographer capturing wildlife from above \ud83c\udfa5\",avatar:\"\ud83e\udd86\", followers:289000, following:234, reelCount:189 },\n    24\u2192  { id:\"du14\", username:\"turtle_tales\",      name:\"Priya Sharma\",     verified:false, country:\"India\",       bio:\"Sea turtle conservationist, Odisha coast \ud83d\udc22\",         avatar:\"\ud83d\udc22\", followers:112000, following:567, reelCount:83  },\n    25\u2192  { id:\"du15\", username:\"forest_whisperer\",  name:\"Yuki Tanaka\",      verified:true,  country:\"Japan\",       bio:\"Red panda & snow leopard photographer \ud83d\udc06\",            avatar:\"\ud83d\udc06\", followers:521000, following:189, reelCount:312 },\n    26\u2192  { id:\"du16\", username:\"reef_ranger_oz\",    name:\"Olivia Chen\",      verified:false, country:\"Australia\",   bio:\"Great Barrier Reef guardian & marine biologist \ud83e\udeb8\",   avatar:\"\ud83d\udc21\", followers:138000, following:740, reelCount:97  },\n    27\u2192  { id:\"du17\", username:\"pangolin_patrol\",   name:\"David Kimani\",     verified:true,  country:\"Kenya\",       bio:\"Anti-poaching advocate & pangolin rescuer \ud83e\udd94\",        avatar:\"\ud83e\udd94\", followers:197000, following:302, reelCount:143 },\n    28\u2192  { id:\"du18\", username:\"mountain_monarch\",  name:\"Ravi Gupta\",       verified:false, country:\"Nepal\",       bio:\"Himalayan trekker & snow leopard spotter \ud83c\udfd4\ufe0f\",         avatar:\"\ud83c\udfd4\ufe0f\", followers:89000,  following:631, reelCount:62  },\n    29\u2192  { id:\"du19\", username:\"wildflower_wren\",   name:\"Sophie Laurent\",   verified:true,  country:\"France\",      bio:\"Pollinator & wildflower conservation photographer \ud83c\udf38\",avatar:\"\ud83c\udf38\", followers:345000, following:421, reelCount:267 },\n    30\u2192  { id:\"du20\", username:\"cheetah_chaser\",    name:\"James Mutua\",      verified:false, country:\"Kenya\",       bio:\"Cheetah Coalition field researcher & tracker \ud83d\udc06\",     avatar:\"\ud83d\udc06\", followers:67000,  following:880, reelCount:51  },\n    31\u2192];\n    32\u2192\n    33\u2192/* ---------- procedural generator seeds ---------- */\n    34\u2192const _PREFIXES = [\n    35\u2192  \"wild\",\"safari\",\"nature\",\"jungle\",\"ocean\",\"forest\",\"desert\",\"mountain\",\n    36\u2192  \"polar\",\"reef\",\"savanna\",\"wetland\",\"rainforest\",\"arctic\",\"coastal\",\n    37\u2192  \"nocturnal\",\"aerial\",\"aquatic\",\"highland\",\"grassland\",\n    38\u2192];\n    39\u2192const _ANIMALS = [\n    40\u2192  \"lion\",\"tiger\",\"elephant\",\"eagle\",\"wolf\",\"dolphin\",\"whale\",\"shark\",\n    41\u2192  \"cheetah\",\"leopard\",\"gorilla\",\"panda\",\"penguin\",\"crocodile\",\"jaguar\",\n    42\u2192  \"manta\",\"orca\",\"falcon\",\"bear\",\"fox\",\"lynx\",\"bison\",\"antelope\",\"flamingo\",\n    43\u2192];\n    44\u2192const _COUNTRIES = [\n    45\u2192  \"Kenya\",\"Tanzania\",\"South Africa\",\"India\",\"Brazil\",\"Indonesia\",\"Canada\",\n    46\u2192  \"Australia\",\"Norway\",\"Japan\",\"Philippines\",\"Colombia\",\"Nepal\",\"France\",\n    47\u2192  \"Sweden\",\"Thailand\",\"Mexico\",\"New Zealand\",\"Costa Rica\",\"Ethiopia\",\n    48\u2192  \"Zambia\",\"Botswana\",\"Ecuador\",\"Malaysia\",\"Sri Lanka\",\"Uganda\",\"Peru\",\n    49\u2192  \"Madagascar\",\"Namibia\",\"Zimbabwe\",\n    50\u2192];\n    51\u2192const _BIO_TEMPLATES = [\n    52\u2192  \"Wildlife photographer capturing the untamed \ud83d\udcf7\",\n    53\u2192  \"Conservation biologist protecting endangered species \ud83c\udf3f\",\n    54\u2192  \"Safari guide with 10 years in the bush \ud83c\udf0d\",\n    55\u2192  \"Marine biologist studying ocean ecosystems \ud83c\udf0a\",\n    56\u2192  \"Raptor researcher tracking migratory birds \ud83e\udd85\",\n    57\u2192  \"Herpetologist documenting tropical reptiles \ud83d\udc0d\",\n    58\u2192  \"Big cat conservationist in the savanna \ud83d\udc06\",\n    59\u2192  \"Deep sea explorer & underwater filmmaker \ud83e\udd3f\",\n    60\u2192  \"National park ranger protecting wild spaces \ud83c\udfd5\ufe0f\",\n    61\u2192  \"Primatologist studying great apes \ud83e\udd8d\",\n    62\u2192  \"Ornithologist documenting rare bird species \ud83e\udd9c\",\n    63\u2192  \"Whale researcher in remote ocean waters \ud83d\udc0b\",\n    64\u2192  \"Anti-poaching advocate & wildlife defender \ud83d\udee1\ufe0f\",\n    65\u2192  \"Nature cinematographer for wildlife docs \ud83c\udfac\",\n    66\u2192  \"Entomologist discovering insect behavior \ud83e\udeb2\",\n    67\u2192  \"Polar wildlife guide & ice researcher \u2744\ufe0f\",\n    68\u2192  \"Coral reef conservationist & diver \ud83e\udeb8\",\n    69\u2192  \"Desert ecology researcher in arid zones \ud83c\udfdc\ufe0f\",\n    70\u2192  \"Mountain wildlife tracker & alpinist \ud83c\udfd4\ufe0f\",\n    71\u2192  \"Freshwater biologist protecting rivers \ud83d\udca7\",\n    72\u2192];\n    73\u2192const _AVATARS = [\"\ud83e\udd81\",\"\ud83d\udc2f\",\"\ud83d\udc18\",\"\ud83e\udd85\",\"\ud83d\udc3a\",\"\ud83d\udc2c\",\"\ud83e\udd88\",\"\ud83d\udc06\",\"\ud83e\udd8d\",\"\ud83d\udc3c\",\"\ud83d\udc27\",\"\ud83d\udc0a\",\"\ud83e\udd93\",\"\ud83e\udd92\",\"\ud83d\udc3b\",\"\ud83e\udd8a\",\"\ud83e\udd9c\",\"\ud83d\udc20\",\"\ud83d\udc22\",\"\ud83e\udd94\",\"\ud83e\udeb8\",\"\ud83e\udd8b\",\"\ud83e\udda9\",\"\ud83d\udc38\",\"\ud83d\udc0d\"];\n    74\u2192\n    75\u2192function _hash(n, mod) {\n    76\u2192  let h = (n * 2654435761) >>> 0;\n    77\u2192  return h % mod;\n    78\u2192}\n    79\u2192\n    80\u2192/* ---------- generate 180 fake users ---------- */\n    81\u2192function _generateFakeUsers() {\n    82\u2192  const users = [];\n    83\u2192  for (let i = 0; i < 180; i++) {\n    84\u2192    const n = i + 1;\n    85\u2192    const prefix = _PREFIXES[_hash(n * 3, _PREFIXES.length)];\n    86\u2192    const animal = _ANIMALS[_hash(n * 7, _ANIMALS.length)];\n    87\u2192    const country = _COUNTRIES[_hash(n * 11, _COUNTRIES.length)];\n    88\u2192    const bio = _BIO_TEMPLATES[_hash(n * 13, _BIO_TEMPLATES.length)];\n    89\u2192    const avatar = _AVATARS[_hash(n * 5, _AVATARS.length)];\n    90\u2192    const followers = 1000 + _hash(n * 17, 95000);\n    91\u2192    const isVerified = followers >= 100000;\n    92\u2192    users.push({\n    93\u2192      id: `fu${String(n).padStart(3, \"0\")}`,\n    94\u2192      username: `${prefix}_${animal}${n}`,\n    95\u2192      name: `Wildlife Creator ${n}`,\n    96\u2192      verified: isVerified,\n    97\u2192      country,\n    98\u2192      bio,\n    99\u2192      avatar,\n   100\u2192      followers,\n   101\u2192      following: 50 + _hash(n * 19, 1200),\n   102\u2192      reelCount: 20,\n   103\u2192    });\n   104\u2192  }\n   105\u2192  return users;\n   106\u2192}\n   107\u2192\n   108\u2192export const FAKE_USERS = _generateFakeUsers();\n   109\u2192export const ALL_USERS = [...DEMO_USERS, ...FAKE_USERS];\n   110\u2192\n   111\u2192/* ---------- reel templates for generation ---------- */\n   112\u2192const _REEL_POOL = [\n   113\u2192  { title:\"Lion Pride at Dusk\",        cat:\"Mammals\",        emoji:\"\ud83e\udd81\", bg:\"linear-gradient(135deg,#f59e0b,#b45309)\", kw:\"lion\" },\n   114\u2192  { title:\"Tiger Hunting at Night\",    cat:\"Mammals\",        emoji:\"\ud83d\udc2f\", bg:\"linear-gradient(135deg,#f97316,#9a3412)\", kw:\"tiger\" },\n   115\u2192  { title:\"Elephant Herd Migration\",   cat:\"Mammals\",        emoji:\"\ud83d\udc18\", bg:\"linear-gradient(135deg,#78716c,#44403c)\", kw:\"elephant\" },\n   116\u2192  { title:\"Cheetah Sprint 120 km/h\",   cat:\"Mammals\",        emoji:\"\ud83d\udc06\", bg:\"linear-gradient(135deg,#fbbf24,#d97706)\", kw:\"cheetah\" },\n   117\u2192  { title:\"Gorilla Family Grooming\",   cat:\"Mammals\",        emoji:\"\ud83e\udd8d\", bg:\"linear-gradient(135deg,#4ade80,#15803d)\", kw:\"gorilla\" },\n   118\u2192  { title:\"Wolf Pack Coordination\",    cat:\"Mammals\",        emoji:\"\ud83d\udc3a\", bg:\"linear-gradient(135deg,#7c3aed,#4c1d95)\", kw:\"wolf\" },\n   119\u2192  { title:\"Polar Bear Arctic Hunt\",    cat:\"Mammals\",        emoji:\"\ud83d\udc3b\u200d\u2744\ufe0f\", bg:\"linear-gradient(135deg,#bae6fd,#0369a1)\", kw:\"polar\" },\n   120\u2192  { title:\"Red Panda in Snow\",         cat:\"Mammals\",        emoji:\"\ud83d\udc3c\", bg:\"linear-gradient(135deg,#f87171,#b91c1c)\", kw:\"panda\" },\n   121\u2192  { title:\"Eagle Precision Strike\",    cat:\"Birds\",          emoji:\"\ud83e\udd85\", bg:\"linear-gradient(135deg,#6366f1,#4338ca)\", kw:\"eagle\" },\n   122\u2192  { title:\"Peregrine Falcon Dive\",     cat:\"Birds\",          emoji:\"\ud83e\udd85\", bg:\"linear-gradient(135deg,#0f172a,#1e3a8a)\", kw:\"falcon\" },\n   123\u2192  { title:\"Lyrebird Perfect Mimic\",    cat:\"Birds\",          emoji:\"\ud83c\udfb5\", bg:\"linear-gradient(135deg,#7dd3fc,#0369a1)\", kw:\"bird\" },\n   124\u2192  { title:\"Flamingo Colony Dance\",     cat:\"Birds\",          emoji:\"\ud83e\udda9\", bg:\"linear-gradient(135deg,#fda4af,#e11d48)\", kw:\"flamingo\" },\n   125\u2192  { title:\"Hummingbird 80 Beats/sec\",  cat:\"Birds\",          emoji:\"\ud83d\udc26\", bg:\"linear-gradient(135deg,#a855f7,#6d28d9)\", kw:\"bird\" },\n   126\u2192  { title:\"Orca Superpod Feeding\",     cat:\"Aquatic\",        emoji:\"\ud83d\udc0b\", bg:\"linear-gradient(135deg,#0ea5e9,#1d4ed8)\", kw:\"orca\" },\n   127\u2192  { title:\"Shark Breach Moment\",       cat:\"Aquatic\",        emoji:\"\ud83e\udd88\", bg:\"linear-gradient(135deg,#0284c7,#075985)\", kw:\"shark\" },\n   128\u2192  { title:\"Octopus Color Change\",      cat:\"Aquatic\",        emoji:\"\ud83d\udc19\", bg:\"linear-gradient(135deg,#ec4899,#be185d)\", kw:\"octopus\" },\n   129\u2192  { title:\"Dolphin Pod Acrobatics\",    cat:\"Aquatic\",        emoji:\"\ud83d\udc2c\", bg:\"linear-gradient(135deg,#22d3ee,#0891b2)\", kw:\"dolphin\" },\n   130\u2192  { title:\"Narwhal Arctic Dance\",      cat:\"Aquatic\",        emoji:\"\ud83e\udd84\", bg:\"linear-gradient(135deg,#67e8f9,#0891b2)\", kw:\"narwhal\" },\n   131\u2192  { title:\"Coral Reef at Sunrise\",     cat:\"Sea\",            emoji:\"\ud83e\udeb8\", bg:\"linear-gradient(135deg,#06b6d4,#0284c7)\", kw:\"reef\" },\n   132\u2192  { title:\"Sea Turtle Nesting Night\",  cat:\"Sea\",            emoji:\"\ud83d\udc22\", bg:\"linear-gradient(135deg,#34d399,#065f46)\", kw:\"turtle\" },\n   133\u2192  { title:\"Bioluminescent Bay Kayak\",  cat:\"Sea\",            emoji:\"\ud83c\udf0a\", bg:\"linear-gradient(135deg,#1e40af,#312e81)\", kw:\"ocean\" },\n   134\u2192  { title:\"Coral Spawning Event\",      cat:\"Sea\",            emoji:\"\ud83e\udeb8\", bg:\"linear-gradient(135deg,#fda4af,#e11d48)\", kw:\"coral\" },\n   135\u2192  { title:\"Anaconda vs Caiman\",        cat:\"Reptiles\",       emoji:\"\ud83d\udc0d\", bg:\"linear-gradient(135deg,#22c55e,#15803d)\", kw:\"anaconda\" },\n   136\u2192  { title:\"Komodo Dragon Hunt\",        cat:\"Reptiles\",       emoji:\"\ud83e\udd8e\", bg:\"linear-gradient(135deg,#84cc16,#4d7c0f)\", kw:\"komodo\" },\n   137\u2192  { title:\"Crocodile Ambush Strike\",   cat:\"Reptiles\",       emoji:\"\ud83d\udc0a\", bg:\"linear-gradient(135deg,#4ade80,#166534)\", kw:\"crocodile\" },\n   138\u2192  { title:\"Mantis Shrimp Power Punch\", cat:\"Small Creatures\",emoji:\"\ud83e\udd90\", bg:\"linear-gradient(135deg,#f97316,#c2410c)\", kw:\"shrimp\" },\n   139\u2192  { title:\"Dragonfly Air Ambush\",      cat:\"Small Creatures\",emoji:\"\ud83e\udeb2\", bg:\"linear-gradient(135deg,#a78bfa,#5b21b6)\", kw:\"dragonfly\" },\n   140\u2192  { title:\"Tree Frog Poison Display\",  cat:\"Small Creatures\",emoji:\"\ud83d\udc38\", bg:\"linear-gradient(135deg,#4ade80,#16a34a)\", kw:\"frog\" },\n   141\u2192  { title:\"Desert Fox Dune Hunt\",      cat:\"Desert\",         emoji:\"\ud83e\udd8a\", bg:\"linear-gradient(135deg,#fcd34d,#b45309)\", kw:\"desert\" },\n   142\u2192  { title:\"Scorpion UV Glow Night\",    cat:\"Desert\",         emoji:\"\ud83e\udd82\", bg:\"linear-gradient(135deg,#4338ca,#1e1b4b)\", kw:\"scorpion\" },\n   143\u2192  { title:\"Snow Leopard Cliff Run\",    cat:\"Mountains\",      emoji:\"\ud83d\udc06\", bg:\"linear-gradient(135deg,#94a3b8,#334155)\", kw:\"leopard\" },\n   144\u2192  { title:\"Mountain Goat Cliff Edge\",  cat:\"Mountains\",      emoji:\"\ud83d\udc10\", bg:\"linear-gradient(135deg,#e2e8f0,#475569)\", kw:\"mountain\" },\n   145\u2192  { title:\"Forest Canopy at Dawn\",     cat:\"Trees\",          emoji:\"\ud83c\udf33\", bg:\"linear-gradient(135deg,#4ade80,#15803d)\", kw:\"forest\" },\n   146\u2192  { title:\"Rainforest Night Sounds\",   cat:\"Trees\",          emoji:\"\ud83c\udf3f\", bg:\"linear-gradient(135deg,#22c55e,#166534)\", kw:\"rainforest\" },\n   147\u2192];\n   148\u2192\n   149\u2192const _DESCS = [\n   150\u2192  \"Rare footage captured at golden hour in the wild.\",\n   151\u2192  \"Witnessed by our team after 3 weeks in the field.\",\n   152\u2192  \"Behaviour never documented before \u2014 a world first.\",\n   153\u2192  \"Ultra slow-motion reveals incredible detail.\",\n   154\u2192  \"Drone footage shows the full scale of this event.\",\n   155\u2192  \"Night-vision camera captures the full sequence.\",\n   156\u2192  \"Hidden camera trap reveals secretive behaviour.\",\n   157\u2192  \"Underwater footage from a depth of 40 metres.\",\n   158\u2192  \"Thermal imaging shows body heat in the cold night.\",\n   159\u2192  \"Scientists estimate only 200 individuals remain.\",\n   160\u2192];\n   161\u2192\n   162\u2192/* ---------- generate 20 reels per user ---------- */\n   163\u2192function _generateUserReels(user) {\n   164\u2192  const reels = [];\n   165\u2192  for (let j = 0; j < 20; j++) {\n   166\u2192    const seed = _hash(parseInt(user.id.replace(/\\D/g,\"\")) * 31 + j * 7, 9999);\n   167\u2192    const tpl = _REEL_POOL[_hash(seed * 3, _REEL_POOL.length)];\n   168\u2192    const desc = _DESCS[_hash(seed * 5, _DESCS.length)];\n   169\u2192    const likes = 100 + _hash(seed * 7, 49900);\n   170\u2192    const views = likes * (3 + _hash(seed * 11, 7));\n   171\u2192    const shares = Math.floor(likes * 0.08);\n   172\u2192    reels.push({\n   173\u2192      id: `${user.id}_r${j}`,\n   174\u2192      type: \"default\",\n   175\u2192      title: `${tpl.title}`,\n   176\u2192      emoji: tpl.emoji,\n   177\u2192      bg: tpl.bg,\n   178\u2192      desc,\n   179\u2192      category: tpl.cat,\n   180\u2192      userId: user.id,\n   181\u2192      username: user.username,\n   182\u2192      userVerified: user.verified,\n   183\u2192      likes,\n   184\u2192      views,\n   185\u2192      shares,\n   186\u2192    });\n   187\u2192  }\n   188\u2192  return reels;\n   189\u2192}\n   190\u2192\n   191\u2192/** Get all reels for a specific user (for profile pages) */\n   192\u2192export function getUserReels(userId) {\n   193\u2192  // Check original demo users first\n   194\u2192  const origReels = DEMO_REELS.filter(r => r.userId === userId);\n   195\u2192  if (origReels.length > 0) return origReels;\n   196\u2192  // Then check fake users\n   197\u2192  const fu = FAKE_USERS.find(u => u.id === userId || u.username === userId);\n   198\u2192  if (fu) return _generateUserReels(fu);\n   199\u2192  return [];\n   200\u2192}\n   201\u2192\n   202\u2192/** 100 curated feed reels from fake users (rotating selection) for the main feed */\n   203\u2192export const FAKE_FEED_REELS = (() => {\n   204\u2192  const picks = [];\n   205\u2192  for (let i = 0; i < 100; i++) {\n   206\u2192    const user = FAKE_USERS[i % FAKE_USERS.length];\n   207\u2192    const tpl = _REEL_POOL[_hash(i * 13, _REEL_POOL.length)];\n   208\u2192    const desc = _DESCS[_hash(i * 7, _DESCS.length)];\n   209\u2192    const likes = 200 + _hash(i * 11, 29800);\n   210\u2192    picks.push({\n   211\u2192      id: `ff${i}`,\n   212\u2192      type: \"default\",\n   213\u2192      title: tpl.title,\n   214\u2192      emoji: tpl.emoji,\n   215\u2192      bg: tpl.bg,\n   216\u2192      desc,\n   217\u2192      category: tpl.cat,\n   218\u2192      userId: user.id,\n   219\u2192      username: user.username,\n   220\u2192      userVerified: user.verified,\n   221\u2192      likes,\n   222\u2192      views: likes * (3 + _hash(i * 3, 7)),\n   223\u2192      shares: Math.floor(likes * 0.07),\n   224\u2192    });\n   225\u2192  }\n   226\u2192  return picks;\n   227\u2192})();\n   228\u2192\n   229\u2192/* ---------- original 26 rich demo reels ---------- */\n   230\u2192const REEL_TEMPLATES = [\n   231\u2192  { title:\"Pride of Lions at Dusk\",        cat:\"Mammals\",        emoji:\"\ud83e\udd81\", bg:\"linear-gradient(135deg,#f59e0b,#b45309)\", desc:\"12 lions share a buffalo kill at golden hour. Maasai Mara, Kenya.\", userId:\"du01\", likes:342000, views:1520000,shares:23400 },\n   232\u2192  { title:\"Orca Superpod Hunt\",            cat:\"Aquatic\",        emoji:\"\ud83d\udc0b\", bg:\"linear-gradient(135deg,#0ea5e9,#1d4ed8)\", desc:\"200+ orcas herd a massive baitball in Norwegian fjords.\",           userId:\"du02\", likes:784000, views:3410000,shares:110200 },\n   233\u2192  { title:\"Cheetah 0\u2013100 Sprint\",          cat:\"Mammals\",        emoji:\"\ud83d\udc06\", bg:\"linear-gradient(135deg,#fbbf24,#d97706)\", desc:\"Slow-motion footage of a cheetah accelerating to 112 km/h.\",       userId:\"du20\", likes:1230000,views:8920000,shares:340000 },\n   234\u2192  { title:\"Eagle Strikes Fish at 80 km/h\", cat:\"Birds\",          emoji:\"\ud83e\udd85\", bg:\"linear-gradient(135deg,#6366f1,#4338ca)\", desc:\"Bald eagle dives and snatches trout from a river in one pass.\",    userId:\"du04\", likes:561000, views:2870000,shares:78000  },\n   235\u2192  { title:\"Anaconda vs Caiman\",            cat:\"Reptiles\",       emoji:\"\ud83d\udc0d\", bg:\"linear-gradient(135deg,#22c55e,#15803d)\", desc:\"Green anaconda subdues a 2-metre caiman in the Pantanal.\",         userId:\"du05\", likes:920000, views:5100000,shares:189000 },\n   236\u2192  { title:\"Wolf Pack Coordinated Hunt\",    cat:\"Mammals\",        emoji:\"\ud83d\udc3a\", bg:\"linear-gradient(135deg,#7c3aed,#4c1d95)\", desc:\"8 wolves use relay tactics to bring down an elk in Yellowstone.\",  userId:\"du06\", likes:810000, views:4200000,shares:125000 },\n   237\u2192  { title:\"Mantis Shrimp 1500 N Punch\",   cat:\"Small Creatures\",emoji:\"\ud83e\udd90\", bg:\"linear-gradient(135deg,#f97316,#c2410c)\", desc:\"High-speed camera captures the deadliest punch in the animal kingdom.\",userId:\"du08\",likes:1140000,views:7200000,shares:280000 },\n   238\u2192  { title:\"Great Barrier Reef Sunrise\",    cat:\"Sea\",            emoji:\"\ud83e\udeb8\", bg:\"linear-gradient(135deg,#06b6d4,#0284c7)\", desc:\"Free dive through a coral garden at first light, GBR, Australia.\", userId:\"du16\", likes:670000, views:3120000,shares:94000  },\n   239\u2192  { title:\"Polar Bear Ice Drift\",          cat:\"Mammals\",        emoji:\"\ud83d\udc3b\u200d\u2744\ufe0f\", bg:\"linear-gradient(135deg,#bae6fd,#0369a1)\", desc:\"Mother polar bear and cubs drift on Arctic sea ice.\",              userId:\"du10\", likes:1420000,views:9500000,shares:420000 },\n   240\u2192  { title:\"Hummingbird 80 Beats/Second\",  cat:\"Birds\",          emoji:\"\ud83d\udc26\", bg:\"linear-gradient(135deg,#a855f7,#6d28d9)\", desc:\"Ultra slow-mo: ruby-throated hummingbird hovers motionless mid-air.\",userId:\"du07\",likes:990000, views:5800000,shares:210000 },\n   241\u2192  { title:\"Desert Fennec Fox Hunt\",        cat:\"Desert\",         emoji:\"\ud83e\udd8a\", bg:\"linear-gradient(135deg,#fcd34d,#b45309)\", desc:\"Fennec fox uses oversized ears to detect mice underground in Sahara.\",userId:\"du12\",likes:430000, views:1980000,shares:52000  },\n   242\u2192  { title:\"Snow Leopard Cliffside Run\",   cat:\"Mountains\",      emoji:\"\ud83d\udc06\", bg:\"linear-gradient(135deg,#94a3b8,#334155)\", desc:\"Rare footage of a snow leopard sprinting on a near-vertical cliff.\", userId:\"du18\", likes:1870000,views:12800000,shares:560000},\n   243\u2192  { title:\"Octopus Colour Change\",         cat:\"Aquatic\",        emoji:\"\ud83d\udc19\", bg:\"linear-gradient(135deg,#ec4899,#be185d)\", desc:\"Pacific giant octopus cycles 30 colour patterns in 4 seconds.\",     userId:\"du02\", likes:880000, views:4700000,shares:170000 },\n   244\u2192  { title:\"Pangolin Armour Defence\",       cat:\"Mammals\",        emoji:\"\ud83e\udd94\", bg:\"linear-gradient(135deg,#84cc16,#4d7c0f)\", desc:\"Pangolin curls into an impenetrable ball \u2014 lion can't open it.\",    userId:\"du17\", likes:720000, views:3800000,shares:110000 },\n   245\u2192  { title:\"Red Panda Mountain Forest\",    cat:\"Mammals\",        emoji:\"\ud83d\udc3c\", bg:\"linear-gradient(135deg,#f87171,#b91c1c)\", desc:\"Red panda tumbles through bamboo in Sikkim, India at -10 \u00b0C.\",     userId:\"du15\", likes:2210000,views:16700000,shares:890000},\n   246\u2192  { title:\"Amazon Tree Frog Choir\",       cat:\"Small Creatures\",emoji:\"\ud83d\udc38\", bg:\"linear-gradient(135deg,#4ade80,#16a34a)\", desc:\"Hundreds of poison dart frogs chorus at dusk in Colombian rainforest.\",userId:\"du11\",likes:510000, views:2300000,shares:67000 },\n   247\u2192  { title:\"Bioluminescent Bay at Night\",  cat:\"Sea\",            emoji:\"\ud83c\udf0a\", bg:\"linear-gradient(135deg,#1e40af,#312e81)\", desc:\"Kayaking through bioluminescent plankton \u2014 every paddle stroke glows.\", userId:\"du08\",likes:1680000,views:11200000,shares:620000},\n   248\u2192  { title:\"Elephant Herd River Crossing\", cat:\"Mammals\",        emoji:\"\ud83d\udc18\", bg:\"linear-gradient(135deg,#78716c,#44403c)\", desc:\"100+ elephants ford the Mara River guided by the oldest matriarch.\", userId:\"du03\", likes:1340000,views:8700000,shares:380000 },\n   249\u2192  { title:\"Peregrine Falcon 389 km/h\",   cat:\"Birds\",          emoji:\"\ud83e\udd85\", bg:\"linear-gradient(135deg,#0f172a,#1e3a8a)\", desc:\"World-record stoop captured by a gyro-stabilised chase drone.\",      userId:\"du04\", likes:2100000,views:14500000,shares:710000},\n   250\u2192  { title:\"Coral Spawning Night\",         cat:\"Sea\",            emoji:\"\ud83e\udeb8\", bg:\"linear-gradient(135deg,#fda4af,#e11d48)\", desc:\"Annual coral mass-spawning \u2014 billions of eggs fill the ocean at once.\",userId:\"du16\",likes:940000, views:5400000,shares:230000 },\n   251\u2192  { title:\"Lyrebird Sound Machine\",       cat:\"Birds\",          emoji:\"\ud83c\udfb5\", bg:\"linear-gradient(135deg,#7dd3fc,#0369a1)\", desc:\"Lyrebird perfectly mimics a chainsaw, camera, and five other birds.\", userId:\"du07\", likes:3120000,views:21000000,shares:1200000},\n   252\u2192  { title:\"Dragonfly Aerial Ambush\",      cat:\"Small Creatures\",emoji:\"\ud83e\udeb2\", bg:\"linear-gradient(135deg,#a78bfa,#5b21b6)\", desc:\"95% success rate: dragonfly intercepts fruit flies mid-flight.\",     userId:\"du11\",likes:680000, views:3500000,shares:120000 },\n   253\u2192  { title:\"Narwhal Arctic Spiral\",        cat:\"Aquatic\",        emoji:\"\ud83e\udd84\", bg:\"linear-gradient(135deg,#67e8f9,#0891b2)\", desc:\"Pod of narwhals spiral their 2-metre tusks near the ice surface.\",   userId:\"du10\", likes:1110000,views:6800000,shares:290000 },\n   254\u2192  { title:\"Cheetah & Cubs Play\",          cat:\"Mammals\",        emoji:\"\ud83d\udc06\", bg:\"linear-gradient(135deg,#fde68a,#f59e0b)\", desc:\"Mother cheetah teaches her 4 cubs stalking technique at Amboseli.\", userId:\"du20\", likes:1760000,views:9800000,shares:440000 },\n   255\u2192  { title:\"Night Scorpion Glows UV\",      cat:\"Desert\",         emoji:\"\ud83e\udd82\", bg:\"linear-gradient(135deg,#4338ca,#1e1b4b)\", desc:\"UV torch reveals 200 scorpions invisible to the naked eye in the Negev.\", userId:\"du12\",likes:830000, views:4400000,shares:160000 },\n   256\u2192  { title:\"Sea Turtle Nesting\",           cat:\"Sea\",            emoji:\"\ud83d\udc22\", bg:\"linear-gradient(135deg,#34d399,#065f46)\", desc:\"Loggerhead turtle lays 120 eggs under a full moon on Odisha beach.\", userId:\"du14\", likes:1490000,views:9200000,shares:510000 },\n   257\u2192];\n   258\u2192\n   259\u2192let _rid = 1;\n   260\u2192export const DEMO_REELS = REEL_TEMPLATES.map(r => ({\n   261\u2192  ...r,\n   262\u2192  id: `dr${_rid++}`,\n   263\u2192  type: \"default\",\n   264\u2192  username: DEMO_USERS.find(u => u.id === r.userId)?.username || \"wildlifeuser\",\n   265\u2192  userVerified: DEMO_USERS.find(u => u.id === r.userId)?.verified || false,\n   266\u2192  category: r.cat,\n   267\u2192}));\n   268\u2192"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/pages/Search.jsx (lines 1-60 of 114)\n     1\u2192import { useState, useMemo, useEffect, useRef } from \"react\";\n     2\u2192import { Link, useLocation } from \"wouter\";\n     3\u2192import { ALL_USERS } from \"../data/demoUsers\";\n     4\u2192import { useAuth } from \"../context/AuthContext\";\n     5\u2192import { useSocial } from \"../context/SocialContext\";\n     6\u2192import BlueTick from \"../components/BlueTick\";\n     7\u2192\n     8\u2192function fmtNum(n) {\n     9\u2192  if (!n) return \"0\";\n    10\u2192  if (n >= 1000000) return (n / 1000000).toFixed(1) + \"M\";\n    11\u2192  if (n >= 1000) return (n / 1000).toFixed(1) + \"K\";\n    12\u2192  return String(n);\n    13\u2192}\n    14\u2192\n    15\u2192function fuzzyScore(username, query) {\n    16\u2192  const u = username.toLowerCase();\n    17\u2192  const q = query.toLowerCase().replace(/\\s+/g, \"\");\n    18\u2192  if (u === q) return 100;\n    19\u2192  if (u.startsWith(q)) return 90;\n    20\u2192  if (u.includes(q)) return 70;\n    21\u2192  // character-level fuzzy\n    22\u2192  let qi = 0;\n    23\u2192  let score = 0;\n    24\u2192  for (let ui = 0; ui < u.length && qi < q.length; ui++) {\n    25\u2192    if (u[ui] === q[qi]) { score += 10; qi++; }\n    26\u2192  }\n    27\u2192  return qi === q.length ? score : 0;\n    28\u2192}\n    29\u2192\n    30\u2192export default function Search() {\n    31\u2192  const [query, setQuery] = useState(\"\");\n    32\u2192  const [, navigate] = useLocation();\n    33\u2192  const { user } = useAuth();\n    34\u2192  const { following, followUser, unfollowUser } = useSocial();\n    35\u2192  const inputRef = useRef(null);\n    36\u2192\n    37\u2192  useEffect(() => { inputRef.current?.focus(); }, []);\n    38\u2192\n    39\u2192  const results = useMemo(() => {\n    40\u2192    const q = query.trim();\n    41\u2192    if (!q) return ALL_USERS.slice(0, 30);\n    42\u2192    return ALL_USERS\n    43\u2192      .map(u => ({ ...u, score: fuzzyScore(u.username, q) + fuzzyScore(u.name, q) * 0.5 }))\n    44\u2192      .filter(u => u.score > 0)\n    45\u2192      .sort((a, b) => b.score - a.score)\n    46\u2192      .slice(0, 50);\n    47\u2192  }, [query]);\n    48\u2192\n    49\u2192  return (\n    50\u2192    <div className=\"search-page\">\n    51\u2192      <div className=\"search-header\">\n    52\u2192        <button className=\"search-back-btn\" onClick={() => navigate(-1)}>\u2190</button>\n    53\u2192        <div className=\"search-input-wrap\">\n    54\u2192          <span className=\"search-icon-inner\">\ud83d\udd0d</span>\n    55\u2192          <input\n    56\u2192            ref={inputRef}\n    57\u2192            className=\"search-main-input\"\n    58\u2192            type=\"text\"\n    59\u2192            placeholder=\"Search wildlife creators\u2026\"\n    60\u2192            value={query}"}]}]}
{"memory_id": 325, "messages": [{"role": "assistant", "content": [{"type": "text", "text": "Let me read the remaining critical files before building:"}]}, {"role": "assistant", "content": [], "tool_calls": [{"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/animal-x/src/pages/UserProfile.jsx", "limit": 80}}, {"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/animal-x/src/pages/Profile.jsx", "limit": 80}}, {"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/animal-x/src/components/Navbar.jsx", "limit": 80}}, {"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/animal-x/src/pages/HelpDesk.jsx", "limit": 60}}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/pages/UserProfile.jsx (lines 1-80 of 246)\n     1\u2192import { useState, useEffect } from \"react\";\n     2\u2192import { useParams, Link, useLocation } from \"wouter\";\n     3\u2192import { doc, getDoc, updateDoc, setDoc } from \"firebase/firestore\";\n     4\u2192import { db } from \"../utils/firebase\";\n     5\u2192import { useAuth } from \"../context/AuthContext\";\n     6\u2192import { useSocial } from \"../context/SocialContext\";\n     7\u2192import { ALL_USERS, getUserReels, FAKE_USERS } from \"../data/demoUsers\";\n     8\u2192import BlueTick from \"../components/BlueTick\";\n     9\u2192\n    10\u2192function fmtNum(n) {\n    11\u2192  if (!n) return \"0\";\n    12\u2192  if (n >= 1000000) return (n / 1000000).toFixed(1) + \"M\";\n    13\u2192  if (n >= 1000) return (n / 1000).toFixed(1) + \"K\";\n    14\u2192  return String(n);\n    15\u2192}\n    16\u2192\n    17\u2192export default function UserProfile() {\n    18\u2192  const { userId } = useParams();\n    19\u2192  const [, navigate] = useLocation();\n    20\u2192  const { user: currentUser, isSuperAdmin, adminMode } = useAuth();\n    21\u2192  const { following, followUser, unfollowUser } = useSocial();\n    22\u2192  const [profile, setProfile] = useState(null);\n    23\u2192  const [loading, setLoading] = useState(true);\n    24\u2192  const [userReels, setUserReels] = useState([]);\n    25\u2192  const [tab, setTab] = useState(\"reels\"); // reels | followers | following\n    26\u2192  const [followersList, setFollowersList] = useState([]);\n    27\u2192  const [followingList, setFollowingList] = useState([]);\n    28\u2192  const [tickMsg, setTickMsg] = useState(null);\n    29\u2192\n    30\u2192  const isFollowing = !!following[userId];\n    31\u2192\n    32\u2192  useEffect(() => {\n    33\u2192    async function load() {\n    34\u2192      setLoading(true);\n    35\u2192      const demo = ALL_USERS.find(u => u.id === userId || u.username === userId);\n    36\u2192      if (demo) {\n    37\u2192        const prof = {\n    38\u2192          uid: demo.id, name: demo.name, username: demo.username,\n    39\u2192          bio: demo.bio, country: demo.country,\n    40\u2192          followers: demo.followers, following: demo.following,\n    41\u2192          reels: demo.reelCount, isVerified: demo.verified, avatar: demo.avatar,\n    42\u2192        };\n    43\u2192        setProfile(prof);\n    44\u2192        setUserReels(getUserReels(demo.id));\n    45\u2192        // Build fake followers/following lists from ALL_USERS\n    46\u2192        const seedN = parseInt(demo.id.replace(/\\D/g, \"\")) || 1;\n    47\u2192        const fakeFollowers = ALL_USERS\n    48\u2192          .filter((u, i) => u.id !== demo.id && (i % (seedN % 5 + 2) === 0))\n    49\u2192          .slice(0, Math.min(demo.followers, 30));\n    50\u2192        const fakeFollowing = ALL_USERS\n    51\u2192          .filter((u, i) => u.id !== demo.id && (i % (seedN % 3 + 1) === 0))\n    52\u2192          .slice(0, Math.min(demo.following, 30));\n    53\u2192        setFollowersList(fakeFollowers);\n    54\u2192        setFollowingList(fakeFollowing);\n    55\u2192        setLoading(false);\n    56\u2192        return;\n    57\u2192      }\n    58\u2192      try {\n    59\u2192        const snap = await getDoc(doc(db, \"users\", userId));\n    60\u2192        if (snap.exists()) {\n    61\u2192          const data = snap.data();\n    62\u2192          setProfile({ uid: userId, ...data });\n    63\u2192          // load followers/following from Firestore\n    64\u2192          try {\n    65\u2192            const [fSnap, fgSnap] = await Promise.all([\n    66\u2192              getDoc(doc(db, \"userFollowers\", userId)),\n    67\u2192              getDoc(doc(db, \"userFollowing\", userId)),\n    68\u2192            ]);\n    69\u2192            const fIds = Object.keys(fSnap.data()?.followers || {}).filter(Boolean).slice(0, 30);\n    70\u2192            const fgIds = Object.keys(fgSnap.data()?.following || {}).filter(Boolean).slice(0, 30);\n    71\u2192            // Resolve names from ALL_USERS or minimal stubs\n    72\u2192            setFollowersList(fIds.map(id => ALL_USERS.find(u => u.id === id) || { id, username: id, name: id }));\n    73\u2192            setFollowingList(fgIds.map(id => ALL_USERS.find(u => u.id === id) || { id, username: id, name: id }));\n    74\u2192          } catch {}\n    75\u2192        } else {\n    76\u2192          setProfile(null);\n    77\u2192        }\n    78\u2192      } catch { setProfile(null); }\n    79\u2192      setLoading(false);\n    80\u2192    }"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/pages/Profile.jsx (lines 1-80 of 638)\n     1\u2192import { useState, useRef } from \"react\";\n     2\u2192import { Link } from \"wouter\";\n     3\u2192import { useAuth } from \"../context/AuthContext\";\n     4\u2192import { useTheme } from \"../context/ThemeContext\";\n     5\u2192import { addCustomAnimal, getCustomAnimals, deleteCustomAnimal } from \"../utils/customAnimals\";\n     6\u2192import { fileToDataURL } from \"../utils/animalOverrides\";\n     7\u2192import { categories } from \"../data/animals\";\n     8\u2192import BlueTick from \"../components/BlueTick\";\n     9\u2192\n    10\u2192function formatCount(n) {\n    11\u2192  if (n == null || isNaN(n)) return \"0\";\n    12\u2192  if (n >= 1_000_000) return (n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 1) + \"M\";\n    13\u2192  if (n >= 1_000) return (n / 1_000).toFixed(n % 1_000 === 0 ? 0 : 1) + \"K\";\n    14\u2192  return String(n);\n    15\u2192}\n    16\u2192\n    17\u2192function parseCount(str) {\n    18\u2192  if (typeof str === \"number\") return str;\n    19\u2192  const s = String(str || \"\").trim().toLowerCase();\n    20\u2192  if (!s) return 0;\n    21\u2192  const m = s.match(/^([\\d.]+)\\s*([kmb]?)$/);\n    22\u2192  if (!m) return parseInt(s.replace(/\\D/g, \"\"), 10) || 0;\n    23\u2192  const n = parseFloat(m[1]);\n    24\u2192  const mult = m[2] === \"k\" ? 1_000 : m[2] === \"m\" ? 1_000_000 : m[2] === \"b\" ? 1_000_000_000 : 1;\n    25\u2192  return Math.round(n * mult);\n    26\u2192}\n    27\u2192\n    28\u2192export default function Profile() {\n    29\u2192  const {\n    30\u2192    user,\n    31\u2192    profile,\n    32\u2192    adminMode,\n    33\u2192    isSuperAdmin,\n    34\u2192    isVerified,\n    35\u2192    verifiedMap,\n    36\u2192    SUPER_ADMIN_EMAIL,\n    37\u2192    unlockAdminMode,\n    38\u2192    lockAdminMode,\n    39\u2192    updateProfile,\n    40\u2192    setVerifiedFor,\n    41\u2192    getAllUsers,\n    42\u2192    logout,\n    43\u2192  } = useAuth();\n    44\u2192  const { theme, toggleTheme } = useTheme();\n    45\u2192\n    46\u2192  const [tapCount, setTapCount] = useState(0);\n    47\u2192  const tapTimer = useRef(null);\n    48\u2192  const [tab, setTab] = useState(\"grid\");\n    49\u2192  const [search, setSearch] = useState(\"\");\n    50\u2192  const [followersInput, setFollowersInput] = useState(\"\");\n    51\u2192  const [postsInput, setPostsInput] = useState(\"\");\n    52\u2192  const [reelsInput, setReelsInput] = useState(\"\");\n    53\u2192  const [editProfileOpen, setEditProfileOpen] = useState(false);\n    54\u2192  const [helpOpen, setHelpOpen] = useState(false);\n    55\u2192  const [nameInput, setNameInput] = useState(user?.name || \"\");\n    56\u2192  const photoFileRef = useRef(null);\n    57\u2192\n    58\u2192  // Add new animal form state\n    59\u2192  const [newName, setNewName] = useState(\"\");\n    60\u2192  const [newCategory, setNewCategory] = useState(categories[0]);\n    61\u2192  const [newImage, setNewImage] = useState(null);\n    62\u2192  const [newHabits, setNewHabits] = useState(\"\");\n    63\u2192  const [newLifespan, setNewLifespan] = useState(\"\");\n    64\u2192  const [newCountry, setNewCountry] = useState(\"\");\n    65\u2192  const [customAnimals, setCustomAnimalsState] = useState(() => getCustomAnimals());\n    66\u2192\n    67\u2192  function refreshCustomList() {\n    68\u2192    setCustomAnimalsState(getCustomAnimals());\n    69\u2192  }\n    70\u2192\n    71\u2192  function handleAvatarTap() {\n    72\u2192    const next = tapCount + 1;\n    73\u2192    setTapCount(next);\n    74\u2192    if (tapTimer.current) clearTimeout(tapTimer.current);\n    75\u2192    tapTimer.current = setTimeout(() => setTapCount(0), 1500);\n    76\u2192    if (next >= 7) {\n    77\u2192      setTapCount(0);\n    78\u2192      if (!user) {\n    79\u2192        alert(\"Please login first to use Admin Mode.\");\n    80\u2192        return;"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/components/Navbar.jsx (lines 1-80 of 147)\n     1\u2192import { useState, useRef } from \"react\";\n     2\u2192import { Link, useLocation } from \"wouter\";\n     3\u2192import { useAuth } from \"../context/AuthContext\";\n     4\u2192import { useSocial } from \"../context/SocialContext\";\n     5\u2192import NotificationBell from \"./NotificationBell\";\n     6\u2192import AdminDebugPanel from \"./AdminDebugPanel\";\n     7\u2192\n     8\u2192const bottomItems = [\n     9\u2192  { href: \"/\", label: \"Home\", icon: \"\ud83c\udfe0\" },\n    10\u2192  { href: \"/animals\", label: \"Animals\", icon: \"\ud83d\udc3e\" },\n    11\u2192  { href: \"/reels\", label: \"Reels\", icon: \"\ud83c\udfac\" },\n    12\u2192  { href: \"/map\", label: \"Map\", icon: \"\ud83d\uddfa\ufe0f\" },\n    13\u2192  { href: \"/travel\", label: \"Travel\", icon: \"\u2708\ufe0f\" },\n    14\u2192  { href: \"/profile\", label: \"Profile\", icon: \"\ud83d\udc64\" },\n    15\u2192];\n    16\u2192\n    17\u2192export default function Navbar() {\n    18\u2192  const [location, navigate] = useLocation();\n    19\u2192  const { user, isSuperAdmin, adminMode, unlockAdminMode, lockAdminMode } = useAuth();\n    20\u2192  const { broadcast, dismissBroadcast, sendBroadcast } = useSocial();\n    21\u2192  const [searchValue, setSearchValue] = useState(\"\");\n    22\u2192  const [tapCount, setTapCount] = useState(0);\n    23\u2192  const [broadcastOpen, setBroadcastOpen] = useState(false);\n    24\u2192  const [broadcastMsg, setBroadcastMsg] = useState(\"\");\n    25\u2192  const [debugOpen, setDebugOpen] = useState(false);\n    26\u2192  const tapTimer = useRef(null);\n    27\u2192  const searchInputRef = useRef(null);\n    28\u2192\n    29\u2192  function submitSearch(e) {\n    30\u2192    e.preventDefault();\n    31\u2192    const q = searchValue.trim();\n    32\u2192    if (!q) return;\n    33\u2192    // If query looks like a username (@...) or search intent, go to user search\n    34\u2192    navigate(`/search?q=${encodeURIComponent(q)}`);\n    35\u2192    setSearchValue(\"\");\n    36\u2192    searchInputRef.current?.blur();\n    37\u2192  }\n    38\u2192\n    39\u2192  function handleLogoTap() {\n    40\u2192    const next = tapCount + 1;\n    41\u2192    setTapCount(next);\n    42\u2192    if (tapTimer.current) clearTimeout(tapTimer.current);\n    43\u2192    tapTimer.current = setTimeout(() => setTapCount(0), 1500);\n    44\u2192    if (next >= 7) {\n    45\u2192      setTapCount(0);\n    46\u2192      if (!user) { alert(\"Please login first.\"); return; }\n    47\u2192      if (!isSuperAdmin) { alert(\"Admin access restricted.\"); return; }\n    48\u2192      if (!adminMode) unlockAdminMode();\n    49\u2192      setBroadcastOpen(v => !v);\n    50\u2192    }\n    51\u2192  }\n    52\u2192\n    53\u2192  async function handleSendBroadcast() {\n    54\u2192    if (!broadcastMsg.trim()) return;\n    55\u2192    await sendBroadcast(broadcastMsg.trim());\n    56\u2192    setBroadcastMsg(\"\");\n    57\u2192    setBroadcastOpen(false);\n    58\u2192    alert(\"\u2705 Broadcast sent to all users!\");\n    59\u2192  }\n    60\u2192\n    61\u2192  return (\n    62\u2192    <>\n    63\u2192      {broadcast && (\n    64\u2192        <div className=\"broadcast-banner\">\n    65\u2192          <span className=\"broadcast-icon\">\ud83d\udce2</span>\n    66\u2192          <span className=\"broadcast-msg\">{broadcast.message}</span>\n    67\u2192          <button className=\"broadcast-dismiss\" onClick={() => dismissBroadcast(broadcast.id)}>\u2715</button>\n    68\u2192        </div>\n    69\u2192      )}\n    70\u2192\n    71\u2192      <header className=\"topbar\">\n    72\u2192        <button className=\"brand-link\" onClick={handleLogoTap} style={{ background:\"none\", border:\"none\", cursor:\"pointer\" }}>\n    73\u2192          <span className=\"brand-icon\">\ud83e\udd81</span>\n    74\u2192          <span className=\"brand-name\">Animal X</span>\n    75\u2192        </button>\n    76\u2192\n    77\u2192        <form className=\"topbar-search\" onSubmit={submitSearch} role=\"search\">\n    78\u2192          <span className=\"topbar-search-icon\">\ud83d\udd0d</span>\n    79\u2192          <input\n    80\u2192            ref={searchInputRef}"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/pages/HelpDesk.jsx (lines 1-60 of 234)\n     1\u2192import { useState } from \"react\";\n     2\u2192import { Link } from \"wouter\";\n     3\u2192\n     4\u2192const TABS = [\"Help Center\", \"Privacy Policy\", \"Terms\", \"Community\"];\n     5\u2192\n     6\u2192export default function HelpDesk() {\n     7\u2192  const [activeTab, setActiveTab] = useState(\"Help Center\");\n     8\u2192  const [formData, setFormData] = useState({ name: \"\", email: \"\", subject: \"\", message: \"\" });\n     9\u2192  const [submitted, setSubmitted] = useState(false);\n    10\u2192\n    11\u2192  const contacts = [\n    12\u2192    { icon: \"\ud83d\udce7\", label: \"Email\", value: \"animalx00003@gmail.com\", href: \"mailto:animalx00003@gmail.com\", color: \"#ea4335\" },\n    13\u2192    { icon: \"\ud83d\udcf8\", label: \"Instagram\", value: \"@wild_life_aniaml_fight\", href: \"https://instagram.com/wild_life_aniaml_fight\", color: \"#e1306c\" },\n    14\u2192    { icon: \"\u25b6\ufe0f\", label: \"YouTube\", value: \"wild_life_aniaml_fight\", href: \"https://youtube.com/@wild_life_aniaml_fight\", color: \"#ff0000\" },\n    15\u2192    { icon: \"\ud83d\udc65\", label: \"Facebook\", value: \"wild_life_aniaml_fight\", href: \"https://facebook.com/wild_life_aniaml_fight\", color: \"#1877f2\" },\n    16\u2192  ];\n    17\u2192\n    18\u2192  const faqs = [\n    19\u2192    { q: \"How do I upload a reel?\", a: \"Go to the Reels tab \u2192 tap the \ud83c\udfac Reels tab \u2192 click '\u2795 Upload Reel'. You must be logged in. Only animal/wildlife/nature content is allowed.\" },\n    20\u2192    { q: \"How do I advertise my product?\", a: \"Go to your Profile page \u2192 tap '\ud83d\udce2 Run Advertisement'. Choose a plan (\u20b9149\u2013\u20b94,999), pay via UPI to nakumamit27-1@okicici, and submit. Admin reviews and activates your ad.\" },\n    21\u2192    { q: \"How do I reset my password?\", a: \"On the Sign In page, tap 'Forgot Password?' below the password field. Enter your email to receive a reset link from Firebase.\" },\n    22\u2192    { q: \"Why do my likes not increase?\", a: \"Animal X uses a real unique-like system \u2014 one like per reel per account. If you've already liked a reel, tapping again will unlike it.\" },\n    23\u2192    { q: \"How do I follow other users?\", a: \"In the Reels feed, tap '+ Follow' next to any creator's username. You can also follow from their profile page.\" },\n    24\u2192    { q: \"How do sponsored ads work?\", a: \"Sponsored ads appear between reels after every 25\u201330 reels. They are clearly labelled as 'Sponsored' and can be skipped.\" },\n    25\u2192    { q: \"How do I contact support?\", a: \"Use the contact form on this page, or reach out via Instagram (@wild_life_aniaml_fight) or Email (animalx00003@gmail.com).\" },\n    26\u2192    { q: \"What animals are in the app?\", a: \"Animal X has 1,213+ animals across 9 categories: Mammals, Reptiles, Birds, Aquatic, Small Creatures, Trees, Mountains, Sea, and Desert.\" },\n    27\u2192    { q: \"Is Animal X free to use?\", a: \"Yes! Animal X is completely free \u2014 no premium, no locks. All features including animals, zoo map, reels, travel, and chatbot are free.\" },\n    28\u2192    { q: \"How does the animal quiz work?\", a: \"Open any animal's detail page and scroll down to find the \ud83e\udde0 Quiz section. Answer 2 questions about the animal and get instant feedback.\" },\n    29\u2192  ];\n    30\u2192\n    31\u2192  return (\n    32\u2192    <div className=\"help-page\">\n    33\u2192      <div className=\"help-header\">\n    34\u2192        <h1 className=\"page-title\">Help & Support</h1>\n    35\u2192        <p className=\"page-subtitle\">We're here to help you explore wildlife safely</p>\n    36\u2192        <Link href=\"/ads\" className=\"help-ads-btn\">\ud83d\udce2 Run Advertisement</Link>\n    37\u2192      </div>\n    38\u2192\n    39\u2192      <div className=\"help-tabs\">\n    40\u2192        {TABS.map(tab => (\n    41\u2192          <button key={tab} className={`help-tab ${activeTab === tab ? \"active\" : \"\"}`} onClick={() => setActiveTab(tab)}>\n    42\u2192            {tab}\n    43\u2192          </button>\n    44\u2192        ))}\n    45\u2192      </div>\n    46\u2192\n    47\u2192      {activeTab === \"Help Center\" && (\n    48\u2192        <div className=\"help-grid\">\n    49\u2192          <div className=\"contact-section\">\n    50\u2192            <h2 className=\"section-title\">\ud83d\udcec Contact Us</h2>\n    51\u2192            <div className=\"contact-cards\">\n    52\u2192              {contacts.map(c => (\n    53\u2192                <a key={c.label} href={c.href} target=\"_blank\" rel=\"noopener noreferrer\" className=\"contact-card\" style={{ borderLeft: `4px solid ${c.color}` }}>\n    54\u2192                  <span className=\"contact-icon\">{c.icon}</span>\n    55\u2192                  <div>\n    56\u2192                    <div className=\"contact-label\">{c.label}</div>\n    57\u2192                    <div className=\"contact-value\">{c.value}</div>\n    58\u2192                  </div>\n    59\u2192                </a>\n    60\u2192              ))}"}]}]}
{"memory_id": 326, "messages": [{"role": "assistant", "content": [{"type": "text", "text": "Let me check the api-server routes before building:"}]}, {"role": "assistant", "content": [], "tool_calls": [{"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/api-server/src/routes/index.ts"}}, {"type": "tool", "name": "glob", "arguments": {"pattern": "artifacts/api-server/src/**/*.ts"}}, {"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/animal-x/src/pages/Ads.jsx", "limit": 50}}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/api-server/src/routes/index.ts\n     1\u2192import { Router, type IRouter } from \"express\";\n     2\u2192import healthRouter from \"./health\";\n     3\u2192import storageRouter from \"./storage\";\n     4\u2192\n     5\u2192const router: IRouter = Router();\n     6\u2192\n     7\u2192router.use(healthRouter);\n     8\u2192router.use(storageRouter);\n     9\u2192\n    10\u2192export default router;\n    11\u2192"}]}, {"role": "tool", "content": [{"type": "text", "text": "./artifacts/api-server/src/routes/index.ts\n./artifacts/api-server/src/routes/storage.ts\n./artifacts/api-server/src/lib/objectStorage.ts\n./artifacts/api-server/src/lib/objectAcl.ts\n./artifacts/api-server/src/routes/health.ts\n./artifacts/api-server/src/lib/logger.ts\n./artifacts/api-server/src/index.ts\n./artifacts/api-server/src/app.ts"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/pages/Ads.jsx (lines 1-50 of 233)\n     1\u2192import { useState } from \"react\";\n     2\u2192import { useAuth } from \"../context/AuthContext\";\n     3\u2192import { useSocial } from \"../context/SocialContext\";\n     4\u2192import { Link } from \"wouter\";\n     5\u2192\n     6\u2192const PLANS = [\n     7\u2192  { id: \"starter\", name: \"Starter\", price: 149, views: \"2,000 Views\", color: \"#22c55e\" },\n     8\u2192  { id: \"basic\", name: \"Basic\", price: 299, views: \"5,000 Views\", color: \"#3b82f6\" },\n     9\u2192  { id: \"growth\", name: \"Growth\", price: 599, views: \"15,000 Views\", color: \"#a855f7\", popular: true },\n    10\u2192  { id: \"business\", name: \"Business\", price: 1499, views: \"50,000 Views\", color: \"#f59e0b\" },\n    11\u2192  { id: \"premium\", name: \"Premium\", price: 4999, views: \"250,000 Views\", color: \"#ef4444\" },\n    12\u2192];\n    13\u2192\n    14\u2192const CATEGORIES = [\n    15\u2192  \"Lions\",\"Tigers\",\"Wolves\",\"Dogs\",\"Cats\",\"Birds\",\"Reptiles\",\"Ocean Animals\",\n    16\u2192  \"Forest Animals\",\"Safari\",\"Nature\",\"Mountains\",\"Desert\",\"Wildlife Travel\",\"Zoo Lovers\",\n    17\u2192];\n    18\u2192\n    19\u2192const UPI_ID = \"nakumamit27-1@okicici\";\n    20\u2192\n    21\u2192export default function Ads() {\n    22\u2192  const { user } = useAuth();\n    23\u2192  const { submitAd } = useSocial();\n    24\u2192\n    25\u2192  const [step, setStep] = useState(1);\n    26\u2192  const [form, setForm] = useState({\n    27\u2192    title: \"\", description: \"\", websiteUrl: \"\", targetCategories: [],\n    28\u2192  });\n    29\u2192  const [selectedPlan, setSelectedPlan] = useState(null);\n    30\u2192  const [paymentDone, setPaymentDone] = useState(false);\n    31\u2192  const [submitting, setSubmitting] = useState(false);\n    32\u2192  const [submitted, setSubmitted] = useState(false);\n    33\u2192  const [copied, setCopied] = useState(false);\n    34\u2192\n    35\u2192  if (!user) {\n    36\u2192    return (\n    37\u2192      <div className=\"ads-page\">\n    38\u2192        <div className=\"ads-login-prompt\">\n    39\u2192          <div style={{ fontSize: 64 }}>\ud83d\udce2</div>\n    40\u2192          <h2>Advertise on Animal X</h2>\n    41\u2192          <p>Reach millions of wildlife lovers. Login to create your first ad.</p>\n    42\u2192          <Link href=\"/auth\" className=\"auth-btn\" style={{ textDecoration: \"none\", display: \"inline-block\", marginTop: 16 }}>\n    43\u2192            \ud83d\udd11 Login to Continue\n    44\u2192          </Link>\n    45\u2192        </div>\n    46\u2192      </div>\n    47\u2192    );\n    48\u2192  }\n    49\u2192\n    50\u2192  if (submitted) {"}]}]}
{"memory_id": 327, "messages": [{"role": "assistant", "content": [{"type": "text", "text": "Now I have the full picture. This is a major rebuild \u2014 let me create the session plan and start implementing in parallel:"}]}, {"role": "assistant", "content": [], "tool_calls": [{"type": "tool", "name": "write", "arguments": {"file_path": ".local/session_plan.md", "content": "# Objective\nProfessional AI-powered wildlife reels platform upgrade\n\n# Tasks\n\n### T001: Rebuild Reels page (TikTok-style snap scroll)\n- Full-screen 9:16 snap scrolling, autoplay videos, like animation\n- Load real Firestore reels + demo seed content mixed in algorithm  \n- Right-side action buttons: like, comment, share, save, follow\n- Double-tap to like, mute/unmute, category filter\n- Upload FAB for logged-in users\n\n### T002: Create CommentsPanel + UploadReel components\n- CommentsPanel: slide-up, Firestore realtime, add/delete comment\n- UploadReel: Object Storage video upload, title/desc/hashtags/category\n- AI moderation: keyword check on title/description before upload\n- Strike system (Firestore userStrikes collection)\n\n### T003: Enhanced Search + UserProfile\n- Search: country, category, display name, @username realtime\n- UserProfile: cover image, total likes, followers/following lists, liked reels tab\n\n### T004: Updated contacts + Ads PayPal\n- HelpDesk: new email wildlifeanimalfight@gmail.com, Instagram/Facebook handle\n- Ads: add PayPal link https://www.paypal.com/ncp/payment/K5VACCZPCJJKG\n- Business account type toggle\n\n### T005: Enhanced Profile + Admin panel\n- Profile: upload photo via Object Storage, edit cover image\n- Admin panel: give/remove blue tick, ban users, featured reels, moderation logs\n\n### T006: CSS for all new features\n- Reels page: snap scroll, reel cards, action buttons, heart anim\n- Comments panel, upload modal\n- Enhanced search, user profile, ads styles\n"}}]}, {"role": "tool", "content": [{"type": "text", "text": "File created successfully at: .local/session_plan.md"}]}]}
{"memory_id": 328, "messages": [{"role": "assistant", "content": [{"type": "text", "text": "Let me check the CSS file length and start building all the major components in parallel:"}]}, {"role": "assistant", "content": [], "tool_calls": [{"type": "tool", "name": "bash", "arguments": {"command": "wc -l artifacts/animal-x/src/styles/app.css", "description": "Check CSS file length", "timeout": 5000}}, {"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/animal-x/src/pages/UserProfile.jsx", "offset": 80, "limit": 80}}, {"type": "tool", "name": "read", "arguments": {"file_path": "artifacts/animal-x/src/context/SocialContext.jsx", "offset": 80, "limit": 80}}]}, {"role": "tool", "content": [{"type": "text", "text": "Command executed successfully.\nThe output was\n```\n5294 artifacts/animal-x/src/styles/app.css\n```"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/pages/UserProfile.jsx (lines 80-159 of 246)\n    80\u2192    }\n    81\u2192    load();\n    82\u2192  }, [userId]);\n    83\u2192\n    84\u2192  async function handleGiveTick(give) {\n    85\u2192    const target = ALL_USERS.find(u => u.id === userId);\n    86\u2192    if (target) {\n    87\u2192      target.verified = give;\n    88\u2192      setProfile(p => ({ ...p, isVerified: give }));\n    89\u2192      setTickMsg(give ? \"\u2705 Blue tick granted!\" : \"\u274c Blue tick removed!\");\n    90\u2192      setTimeout(() => setTickMsg(null), 3000);\n    91\u2192      return;\n    92\u2192    }\n    93\u2192    try {\n    94\u2192      await setDoc(doc(db, \"users\", userId), { manualVerified: give }, { merge: true });\n    95\u2192      setProfile(p => ({ ...p, isVerified: give, manualVerified: give }));\n    96\u2192      setTickMsg(give ? \"\u2705 Blue tick granted!\" : \"\u274c Blue tick removed!\");\n    97\u2192      setTimeout(() => setTickMsg(null), 3000);\n    98\u2192    } catch (e) { alert(\"Error: \" + e.message); }\n    99\u2192  }\n   100\u2192\n   101\u2192  if (loading) return (\n   102\u2192    <div className=\"user-profile-page\">\n   103\u2192      <div className=\"user-profile-loading\"><div style={{ fontSize: \"3rem\" }}>\ud83d\udc3e</div><p>Loading profile\u2026</p></div>\n   104\u2192    </div>\n   105\u2192  );\n   106\u2192\n   107\u2192  if (!profile) return (\n   108\u2192    <div className=\"user-profile-page\">\n   109\u2192      <div className=\"not-found\">\n   110\u2192        <div style={{ fontSize: \"3rem\" }}>\ud83d\udc64</div>\n   111\u2192        <h2>User not found</h2>\n   112\u2192        <Link href=\"/reels\" className=\"back-btn\">\u2190 Back to Reels</Link>\n   113\u2192      </div>\n   114\u2192    </div>\n   115\u2192  );\n   116\u2192\n   117\u2192  const isOwn = currentUser?.uid === profile.uid;\n   118\u2192  const canManageTick = isSuperAdmin && adminMode;\n   119\u2192\n   120\u2192  return (\n   121\u2192    <div className=\"user-profile-page\">\n   122\u2192      {tickMsg && <div className=\"tick-msg-toast\">{tickMsg}</div>}\n   123\u2192\n   124\u2192      <div className=\"up-header\">\n   125\u2192        <button className=\"up-back-btn\" onClick={() => navigate(-1)}>\u2190 Back</button>\n   126\u2192        {canManageTick && (\n   127\u2192          <div className=\"admin-tick-controls\">\n   128\u2192            <span style={{ fontSize: \"0.72rem\", color: \"#a855f7\", fontWeight: 700 }}>ADMIN</span>\n   129\u2192            <button className=\"atick-btn give\" onClick={() => handleGiveTick(true)}>\u2713 Give Blue Tick</button>\n   130\u2192            <button className=\"atick-btn remove\" onClick={() => handleGiveTick(false)}>\u2715 Remove Tick</button>\n   131\u2192          </div>\n   132\u2192        )}\n   133\u2192      </div>\n   134\u2192\n   135\u2192      <div className=\"up-card\">\n   136\u2192        <div className=\"up-avatar-wrap\">\n   137\u2192          <div className=\"up-avatar\">{profile.avatar || (profile.name?.[0]?.toUpperCase() || \"U\")}</div>\n   138\u2192          {profile.isVerified && <div className=\"up-avatar-tick\"><BlueTick size={18} /></div>}\n   139\u2192        </div>\n   140\u2192        <div className=\"up-name\">\n   141\u2192          {profile.name || profile.username}\n   142\u2192          {profile.isVerified && <BlueTick size={20} />}\n   143\u2192        </div>\n   144\u2192        <div className=\"up-username\">@{profile.username || profile.email?.split(\"@\")[0]}</div>\n   145\u2192        {profile.bio && <p className=\"up-bio\">{profile.bio}</p>}\n   146\u2192        {profile.country && <div className=\"up-country\">\ud83d\udccd {profile.country}</div>}\n   147\u2192\n   148\u2192        <div className=\"up-stats\">\n   149\u2192          <div className=\"up-stat\" onClick={() => setTab(\"reels\")} style={{ cursor: \"pointer\" }}>\n   150\u2192            <div className=\"up-stat-val\">{fmtNum(profile.reels || 0)}</div>\n   151\u2192            <div className=\"up-stat-label\">Reels</div>\n   152\u2192          </div>\n   153\u2192          <div className=\"up-stat\" onClick={() => setTab(\"followers\")} style={{ cursor: \"pointer\" }}>\n   154\u2192            <div className=\"up-stat-val\">{fmtNum(profile.followers || 0)}</div>\n   155\u2192            <div className=\"up-stat-label\">Followers</div>\n   156\u2192          </div>\n   157\u2192          <div className=\"up-stat\" onClick={() => setTab(\"following\")} style={{ cursor: \"pointer\" }}>\n   158\u2192            <div className=\"up-stat-val\">{fmtNum(profile.following || 0)}</div>\n   159\u2192            <div className=\"up-stat-label\">Following</div>"}]}, {"role": "tool", "content": [{"type": "text", "text": "Here's the result of running `cat -n` on a snippet of artifacts/animal-x/src/context/SocialContext.jsx (lines 80-159 of 250)\n    80\u2192  }, [user?.uid]);\n    81\u2192\n    82\u2192  useEffect(() => {\n    83\u2192    const unsub = onSnapshot(\n    84\u2192      query(collection(db, \"adminBroadcasts\"), where(\"active\", \"==\", true), limit(1)),\n    85\u2192      (snap) => {\n    86\u2192        if (!snap.empty) setBroadcast({ id: snap.docs[0].id, ...snap.docs[0].data() });\n    87\u2192        else setBroadcast(null);\n    88\u2192      },\n    89\u2192      () => {}\n    90\u2192    );\n    91\u2192    return unsub;\n    92\u2192  }, []);\n    93\u2192\n    94\u2192  useEffect(() => {\n    95\u2192    const onlineRef = ref(rtdb, \"online-users\");\n    96\u2192    const unsub = onValue(onlineRef, (snap) => {\n    97\u2192      const data = snap.val() || {};\n    98\u2192      setOnlineCount(Object.keys(data).filter(k => data[k] === true).length);\n    99\u2192    }, () => {});\n   100\u2192    const trendRef = ref(rtdb, \"trending\");\n   101\u2192    const trendUnsub = onValue(trendRef, (snap) => {\n   102\u2192      const data = snap.val() || {};\n   103\u2192      setTrending(Object.entries(data).map(([id, v]) => ({ id, ...v })).sort((a, b) => (b.score||0)-(a.score||0)).slice(0,10));\n   104\u2192    }, () => {});\n   105\u2192    const viewsRef = ref(rtdb, \"live-views\");\n   106\u2192    const viewsUnsub = onValue(viewsRef, (snap) => { setLiveViews(snap.val() || {}); }, () => {});\n   107\u2192    return () => { unsub(); trendUnsub(); viewsUnsub(); };\n   108\u2192  }, []);\n   109\u2192\n   110\u2192  useEffect(() => {\n   111\u2192    if (!user?.uid) return;\n   112\u2192    const userOnlineRef = ref(rtdb, `online-users/${user.uid}`);\n   113\u2192    rtdbSet(userOnlineRef, true).catch(() => {});\n   114\u2192    onDisconnect(userOnlineRef).set(null);\n   115\u2192    return () => { rtdbSet(userOnlineRef, null).catch(() => {}); };\n   116\u2192  }, [user?.uid]);\n   117\u2192\n   118\u2192  function trackReelView(reelId) {\n   119\u2192    if (!reelId) return;\n   120\u2192    const viewRef = ref(rtdb, `live-views/${reelId}`);\n   121\u2192    rtdbSet(viewRef, (liveViews[reelId] || 0) + 1).catch(() => {});\n   122\u2192    const trendRef = ref(rtdb, `trending/${reelId}/score`);\n   123\u2192    rtdbSet(trendRef, ((trending.find(t => t.id === reelId)?.score) || 0) + 1).catch(() => {});\n   124\u2192  }\n   125\u2192\n   126\u2192  function likeReelLive(reelId) {\n   127\u2192    if (!reelId) return;\n   128\u2192    const likeRef = ref(rtdb, `live-likes/${reelId}`);\n   129\u2192    rtdbSet(likeRef, Date.now()).catch(() => {});\n   130\u2192  }\n   131\u2192\n   132\u2192  async function loadUserLikes(uid) {\n   133\u2192    try {\n   134\u2192      const snap = await getDoc(doc(db, \"userLikes\", uid));\n   135\u2192      if (snap.exists()) {\n   136\u2192        const liked = snap.data().liked || {};\n   137\u2192        setLikedReels(liked);\n   138\u2192        localStorage.setItem(`ax_liked_${uid}`, JSON.stringify(liked));\n   139\u2192      }\n   140\u2192    } catch {}\n   141\u2192  }\n   142\u2192\n   143\u2192  async function loadUserFollowing(uid) {\n   144\u2192    try {\n   145\u2192      const snap = await getDoc(doc(db, \"userFollowing\", uid));\n   146\u2192      if (snap.exists()) {\n   147\u2192        const f = snap.data().following || {};\n   148\u2192        setFollowing(f);\n   149\u2192        localStorage.setItem(`ax_following_${uid}`, JSON.stringify(f));\n   150\u2192      }\n   151\u2192    } catch {}\n   152\u2192  }\n   153\u2192\n   154\u2192  async function likeReel(reelId) {\n   155\u2192    if (!user?.uid) return;\n   156\u2192    const uid = user.uid;\n   157\u2192    const isLiked = !!likedReels[reelId];\n   158\u2192    setLikedReels(prev => {\n   159\u2192      const next = { ...prev };"}]}]}
{"memory_id": 329, "messages": [{"role": "assistant", "content": [{"type": "text", "text": "Now I have everything I need. Let me implement all the major features in parallel:"}]}, {"role": "assistant", "content": [], "tool_calls": [{"type": "tool", "name": "write", "arguments": {"file_path": "artifacts/animal-x/src/pages/Reels.jsx", "content": "import React, { useState, useEffect, useRef, useCallback } from \"react\";\nimport { useLocation, Link } from \"wouter\";\nimport {\n  collection, query, orderBy, limit, onSnapshot,\n  doc, getDoc, setDoc, updateDoc, increment, serverTimestamp, addDoc, deleteDoc\n} from \"firebase/firestore\";\nimport { db } from \"../utils/firebase\";\nimport { useAuth } from \"../context/AuthContext\";\nimport { useSocial } from \"../context/SocialContext\";\nimport { DEMO_REELS, FAKE_FEED_REELS, ALL_USERS } from \"../data/demoUsers\";\nimport BlueTick from \"../components/BlueTick\";\nimport CommentsPanel from \"../components/CommentsPanel\";\nimport UploadReel from \"../components/UploadReel\";\n\nfunction fmt(n) {\n  if (!n) return \"0\";\n  if (n >= 1000000) return (n / 1000000).toFixed(1) + \"M\";\n  if (n >= 1000) return (n / 1000).toFixed(1) + \"K\";\n  return String(n);\n}\n\nconst CATS = [\"All\",\"Mammals\",\"Birds\",\"Aquatic\",\"Reptiles\",\"Small Creatures\",\"Trees\",\"Mountains\",\"Sea\",\"Desert\"];\n\nconst WILDLIFE_KW = [\n  \"lion\",\"tiger\",\"elephant\",\"eagle\",\"wolf\",\"dolphin\",\"whale\",\"shark\",\"cheetah\",\"leopard\",\n  \"gorilla\",\"panda\",\"penguin\",\"crocodile\",\"jaguar\",\"orca\",\"falcon\",\"bear\",\"fox\",\"lynx\",\n  \"bison\",\"flamingo\",\"animal\",\"wildlife\",\"nature\",\"forest\",\"jungle\",\"bird\",\"ocean\",\"reptile\",\n  \"snake\",\"fish\",\"reef\",\"coral\",\"turtle\",\"frog\",\"insect\",\"safari\",\"savanna\",\"arctic\",\n  \"mountain\",\"desert\",\"rainforest\",\"conservation\",\"wild\",\"mammal\",\"primate\",\"raptor\",\"marine\",\n];\n\nexport function moderateContent(title, desc, hashtags) {\n  const text = `${title} ${desc} ${hashtags}`.toLowerCase();\n  return WILDLIFE_KW.some(w => text.includes(w));\n}\n\nfunction buildFeed(liveReels, catFilter) {\n  const all = [\n    ...liveReels.map(r => ({ ...r, _rank: 2000 + (r.likes || 0) * 0.01 + (Date.now() - (r.createdAt?.toMillis?.() || 0)) * -0.000001 })),\n    ...DEMO_REELS.map(r => ({ ...r, _rank: 800 + (r.likes || 0) * 0.005 })),\n    ...FAKE_FEED_REELS.slice(0, 80).map(r => ({ ...r, _rank: 200 + (r.likes || 0) * 0.001 })),\n  ];\n  const seen = new Set();\n  const deduped = all.filter(r => { if (seen.has(r.id)) return false; seen.add(r.id); return true; });\n  const filtered = catFilter === \"All\" ? deduped : deduped.filter(r => r.category === catFilter || r.cat === catFilter);\n  return filtered.sort((a, b) => b._rank - a._rank);\n}\n\nfunction getDemoUser(userId) {\n  return ALL_USERS.find(u => u.id === userId || u.username === userId);\n}\n\nexport default function Reels() {\n  const [, navigate] = useLocation();\n  const { user, adminMode, isSuperAdmin } = useAuth();\n  const { likedReels, likeReel, following, followUser, unfollowUser, trackReelView } = useSocial();\n\n  const [liveReels, setLiveReels] = useState([]);\n  const [feed, setFeed] = useState([]);\n  const [catFilter, setCatFilter] = useState(\"All\");\n  const [activeIdx, setActiveIdx] = useState(0);\n  const [muted, setMuted] = useState(true);\n  const [commentsReel, setCommentsReel] = useState(null);\n  const [uploadOpen, setUploadOpen] = useState(false);\n  const [heartAnims, setHeartAnims] = useState({});\n  const [savedReels, setSavedReels] = useState(() => {\n    try { return JSON.parse(localStorage.getItem(\"ax_saved_reels\") || \"{}\"); } catch { return {}; }\n  });\n  const [liveLikes, setLiveLikes] = useState({});\n  const [doubleTapTimeout, setDoubleTapTimeout] = useState({});\n\n  const scrollRef = useRef(null);\n  const videoRefs = useRef({});\n  const observerRef = useRef(null);\n  const lastTapRef = useRef({});\n\n  useEffect(() => {\n    const q = query(collection(db, \"reels\"), orderBy(\"createdAt\", \"desc\"), limit(100));\n    const unsub = onSnapshot(q, snap => {\n      const reels = snap.docs.map(d => ({ id: d.id, ...d.data(), type: \"live\" }));\n      setLiveReels(reels);\n    }, () => {});\n    return unsub;\n  }, []);\n\n  useEffect(() => {\n    setFeed(buildFeed(liveReels, catFilter));\n    setActiveIdx(0);\n    if (scrollRef.current) scrollRef.current.scrollTo({ top: 0, behavior: \"instant\" });\n  }, [liveReels, catFilter]);\n\n  useEffect(() => {\n    if (!scrollRef.current || feed.length === 0) return;\n    observerRef.current?.disconnect();\n    const obs = new IntersectionObserver(entries => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {\n          const idx = Number(entry.target.dataset.idx);\n          setActiveIdx(idx);\n          const reel = feed[idx];\n          if (reel?.id) trackReelView(reel.id);\n          Object.entries(videoRefs.current).forEach(([vi, el]) => {\n            if (!el) return;\n            if (Number(vi) === idx) { el.muted = muted; el.play().catch(() => {}); }\n            else { el.pause(); }\n          });\n        }\n      });\n    }, { threshold: 0.6, root: scrollRef.current });\n    const slides = scrollRef.current.querySelectorAll(\"[data-idx]\");\n    slides.forEach(s => obs.observe(s));\n    observerRef.current = obs;\n    return () => obs.disconnect();\n  }, [feed.length, muted]);\n\n  const triggerHeart = useCallback((id) => {\n    setHeartAnims(h => ({ ...h, [id]: true }));\n    setTimeout(() => setHeartAnims(h => ({ ...h, [id]: false })), 800);\n  }, []);\n\n  async function handleLike(reel) {\n    if (!user) { navigate(\"/auth\"); return; }\n    const already = !!likedReels[reel.id];\n    if (!already) triggerHeart(reel.id);\n    setLiveLikes(p => ({ ...p, [reel.id]: (p[reel.id] ?? reel.likes ?? 0) + (already ? -1 : 1) }));\n    await likeReel(reel.id, reel.likes || 0);\n  }\n\n  function handleDoubleTap(reel, e) {\n    const now = Date.now();\n    const last = lastTapRef.current[reel.id] || 0;\n    if (now - last < 350) {\n      if (user && !likedReels[reel.id]) {\n        handleLike(reel);\n      } else if (!user) {\n        triggerHeart(reel.id);\n      }\n    }\n    lastTapRef.current[reel.id] = now;\n  }\n\n  function handleSave(reelId) {\n    const next = { ...savedReels, [reelId]: !savedReels[reelId] };\n    if (!next[reelId]) delete next[reelId];\n    setSavedReels(next);\n    localStorage.setItem(\"ax_saved_reels\", JSON.stringify(next));\n  }\n\n  async function handleShare(reel) {\n    const text = `${reel.title} \u2014 Animal X Wildlife\\n#wildlifeapp`;\n    if (navigator.share) {\n      try { await navigator.share({ title: reel.title, text, url: window.location.href }); return; } catch {}\n    }\n    try { await navigator.clipboard.writeText(text); alert(\"Link copied!\"); } catch {}\n  }\n\n  async function handleDeleteReel(reelId) {\n    if (!window.confirm(\"Delete this reel?\")) return;\n    try { await deleteDoc(doc(db, \"reels\", reelId)); } catch (e) { alert(e.message); }\n  }\n\n  function handleFollowToggle(targetUserId) {\n    if (!user) { navigate(\"/auth\"); return; }\n    if (following[targetUserId]) unfollowUser(targetUserId);\n    else followUser(targetUserId);\n  }\n\n  const currentReel = feed[activeIdx];\n\n  return (\n    <div className=\"reels-page\">\n      <div className=\"reels-top-bar\">\n        <span className=\"reels-top-title\">\ud83c\udfac Wildlife Reels</span>\n        <div className=\"reels-top-actions\">\n          {user && (\n            <button className=\"reels-upload-btn\" onClick={() => setUploadOpen(true)}>\n              \u2795 Upload\n            </button>\n          )}\n        </div>\n      </div>\n\n      <div className=\"reels-cat-bar\">\n        {CATS.map(c => (\n          <button\n            key={c}\n            className={`reel-cat-pill ${catFilter === c ? \"active\" : \"\"}`}\n            onClick={() => setCatFilter(c)}\n          >{c}</button>\n        ))}\n      </div>\n\n      <div className=\"reels-scroll\" ref={scrollRef}>\n        {feed.length === 0 ? (\n          <div className=\"reels-empty\">\n            <div style={{ fontSize: \"4rem\" }}>\ud83e\udd81</div>\n            <h3>No reels yet</h3>\n            <p>Be the first to upload a wildlife reel!</p>\n          </div>\n        ) : (\n          feed.map((reel, idx) => {\n            const liked = !!likedReels[reel.id];\n            const saved = !!savedReels[reel.id];\n            const likes = liveLikes[reel.id] ?? reel.likes ?? 0;\n            const demoUser = getDemoUser(reel.userId);\n            const isOwn = user?.uid === reel.userId;\n            const isAdmin = isSuperAdmin && adminMode;\n            const isFollowed = !!following[reel.userId];\n            const isActive = idx === activeIdx;\n\n            return (\n              <div\n                key={reel.id}\n                className={`reel-item ${isActive ? \"active\" : \"\"}`}\n                data-idx={idx}\n                onClick={(e) => handleDoubleTap(reel, e)}\n              >\n                {reel.videoUrl ? (\n                  <video\n                    ref={el => { if (el) videoRefs.current[idx] = el; }}\n                    className=\"reel-video\"\n                    src={`/api/storage${reel.videoUrl}`}\n                    loop\n                    playsInline\n                    muted={muted}\n                    poster={reel.thumbnailUrl ? `/api/storage${reel.thumbnailUrl}` : undefined}\n                  />\n                ) : (\n                  <div className=\"reel-demo-bg\" style={{ background: reel.bg || \"linear-gradient(135deg,#0f4c2a,#065f46)\" }}>\n                    <div className=\"reel-demo-emoji\">{reel.emoji || \"\ud83d\udc3e\"}</div>\n                  </div>\n                )}\n\n                {heartAnims[reel.id] && (\n                  <div className=\"reel-heart-burst\">\u2764\ufe0f</div>\n                )}\n\n                <div className=\"reel-gradient-overlay\" />\n\n                {reel.sponsored && (\n                  <div className=\"reel-sponsored-tag\">Sponsored</div>\n                )}\n\n                <div className=\"reel-overlay-bottom\">\n                  <div className=\"reel-creator-row\">\n                    <Link href={`/user/${reel.userId}`} onClick={e => e.stopPropagation()}>\n                      <div className=\"reel-avatar\">\n                        {demoUser?.avatar || reel.userAvatar || (reel.username?.[0]?.toUpperCase() || \"\ud83d\udc3e\")}\n                      </div>\n                    </Link>\n                    <div className=\"reel-creator-info\">\n                      <Link href={`/user/${reel.userId}`} onClick={e => e.stopPropagation()} className=\"reel-username-link\">\n                        @{reel.username || \"wildlifeuser\"}\n                        {(reel.userVerified || demoUser?.verified) && <BlueTick size={14} />}\n                      </Link>\n                    </div>\n                    {!isOwn && (\n                      <button\n                        className={`reel-follow-btn ${isFollowed ? \"following\" : \"\"}`}\n                        onClick={e => { e.stopPropagation(); handleFollowToggle(reel.userId); }}\n                      >\n                        {isFollowed ? \"Following\" : \"+ Follow\"}\n                      </button>\n                    )}\n                  </div>\n                  <div className=\"reel-title\">{reel.title}</div>\n                  {reel.desc && <div className=\"reel-desc\">{reel.desc.length > 80 ? reel.desc.slice(0, 80) + \"\u2026\" : reel.desc}</div>}\n                  {reel.hashtags && (\n                    <div className=\"reel-hashtags\">\n                      {String(reel.hashtags).split(/[\\s,]+/).filter(Boolean).slice(0, 4).map(h => (\n                        <span key={h} className=\"reel-hashtag\">{h.startsWith(\"#\") ? h : \"#\" + h}</span>\n                      ))}\n                    </div>\n                  )}\n                  <div className=\"reel-meta-row\">\n                    <span>\ud83d\udc41\ufe0f {fmt(reel.views || 0)}</span>\n                    <span>\ud83d\udd17 {fmt(reel.shares || 0)}</span>\n                    {reel.location && <span>\ud83d\udccd {reel.location}</span>}\n                    <span className=\"reel-cat-badge\">{reel.category || reel.cat}</span>\n                  </div>\n                </div>\n\n                <div className=\"reel-actions-right\">\n                  <div className=\"reel-action-col\">\n                    <button\n                      className={`reel-action-btn like-btn ${liked ? \"liked\" : \"\"}`}\n                      onClick={e => { e.stopPropagation(); handleLike(reel); }}\n                    >\n                      <span className=\"reel-action-icon\">{liked ? \"\u2764\ufe0f\" : \"\ud83e\udd0d\"}</span>\n                      <span className=\"reel-action-count\">{fmt(likes)}</span>\n                    </button>\n                    <button\n                      className=\"reel-action-btn\"\n                      onClick={e => { e.stopPropagation(); setCommentsReel(reel); }}\n                    >\n                      <span className=\"reel-action-icon\">\ud83d\udcac</span>\n                      <span className=\"reel-action-count\">{fmt(reel.comments || 0)}</span>\n                    </button>\n                    <button\n                      className=\"reel-action-btn\"\n                      onClick={e => { e.stopPropagation(); handleShare(reel); }}\n                    >\n                      <span className=\"reel-action-icon\">\u2197\ufe0f</span>\n                      <span className=\"reel-action-count\">{fmt(reel.shares || 0)}</span>\n                    </button>\n                    <button\n                      className={`reel-action-btn ${saved ? \"saved\" : \"\"}`}\n                      onClick={e => { e.stopPropagation(); handleSave(reel.id); }}\n                    >\n                      <span className=\"reel-action-icon\">{saved ? \"\ud83d\udd16\" : \"\ud83d\udccc\"}</span>\n                      <span className=\"reel-action-count\">Save</span>\n                    </button>\n                    {reel.videoUrl && (\n                      <button\n                        className=\"reel-action-btn\"\n                        onClick={e => { e.stopPropagation(); setMuted(m => !m); }}\n                      >\n                        <span className=\"reel-action-icon\">{muted ? \"\ud83d\udd07\" : \"\ud83d\udd0a\"}</span>\n                        <span className=\"reel-action-count\">{muted ? \"Muted\" : \"Sound\"}</span>\n                      </button>\n                    )}\n                    {(isOwn || isAdmin) && (\n                      <button\n                        className=\"reel-action-btn danger-btn\"\n                        onClick={e => { e.stopPropagation(); handleDeleteReel(reel.id); }}\n                      >\n                        <span className=\"reel-action-icon\">\ud83d\uddd1\ufe0f</span>\n                        <span className=\"reel-action-count\">Delete</span>\n                      </button>\n                    )}\n                  </div>\n                </div>\n              </div>\n            );\n          })\n        )}\n      </div>\n\n      {commentsReel && (\n        <CommentsPanel reel={commentsReel} onClose={() => setCommentsReel(null)} />\n      )}\n      {uploadOpen && (\n        <UploadReel onClose={() => setUploadOpen(false)} onUploaded={() => setUploadOpen(false)} />\n      )}\n    </div>\n  );\n}\n"}}, {"type": "tool", "name": "write", "arguments": {"file_path": "artifacts/animal-x/src/components/CommentsPanel.jsx", "content": "import { useState, useEffect, useRef } from \"react\";\nimport {\n  collection, query, orderBy, limit, onSnapshot,\n  addDoc, serverTimestamp, deleteDoc, doc\n} from \"firebase/firestore\";\nimport { db } from \"../utils/firebase\";\nimport { useAuth } from \"../context/AuthContext\";\nimport BlueTick from \"./BlueTick\";\n\nfunction fmt(n) {\n  if (!n) return \"0\";\n  if (n >= 1000) return (n / 1000).toFixed(1) + \"K\";\n  return String(n);\n}\n\nexport default function CommentsPanel({ reel, onClose }) {\n  const { user, profile, isSuperAdmin, adminMode } = useAuth();\n  const [comments, setComments] = useState([]);\n  const [text, setText] = useState(\"\");\n  const [submitting, setSubmitting] = useState(false);\n  const panelRef = useRef(null);\n  const inputRef = useRef(null);\n\n  useEffect(() => {\n    if (!reel?.id) return;\n    const q = query(\n      collection(db, \"reels\", reel.id, \"comments\"),\n      orderBy(\"createdAt\", \"asc\"),\n      limit(100)\n    );\n    const unsub = onSnapshot(q, snap => {\n      setComments(snap.docs.map(d => ({ id: d.id, ...d.data() })));\n    }, () => setComments([]));\n    return unsub;\n  }, [reel?.id]);\n\n  useEffect(() => {\n    function onKey(e) { if (e.key === \"Escape\") onClose(); }\n    document.addEventListener(\"keydown\", onKey);\n    return () => document.removeEventListener(\"keydown\", onKey);\n  }, [onClose]);\n\n  async function handleSubmit(e) {\n    e.preventDefault();\n    if (!user) { alert(\"Please login to comment.\"); return; }\n    const t = text.trim();\n    if (!t) return;\n    setSubmitting(true);\n    try {\n      await addDoc(collection(db, \"reels\", reel.id, \"comments\"), {\n        text: t,\n        userId: user.uid,\n        username: profile?.username || user.name || user.email?.split(\"@\")[0],\n        userVerified: profile?.manualVerified || false,\n        createdAt: serverTimestamp(),\n      });\n      setText(\"\");\n    } catch {}\n    setSubmitting(false);\n  }\n\n  async function handleDelete(commentId) {\n    try { await deleteDoc(doc(db, \"reels\", reel.id, \"comments\", commentId)); } catch {}\n  }\n\n  function timeAgo(ts) {\n    if (!ts?.toDate) return \"\";\n    const diff = (Date.now() - ts.toDate().getTime()) / 1000;\n    if (diff < 60) return \"just now\";\n    if (diff < 3600) return Math.floor(diff / 60) + \"m\";\n    if (diff < 86400) return Math.floor(diff / 3600) + \"h\";\n    return Math.floor(diff / 86400) + \"d\";\n  }\n\n  return (\n    <div className=\"comments-backdrop\" onClick={e => { if (e.target === e.currentTarget) onClose(); }}>\n      <div className=\"comments-panel\" ref={panelRef}>\n        <div className=\"comments-header\">\n          <span className=\"comments-title\">\ud83d\udcac Comments ({comments.length})</span>\n          <button className=\"comments-close\" onClick={onClose}>\u2715</button>\n        </div>\n\n        <div className=\"comments-reel-preview\">\n          <div className=\"crp-emoji\">{reel.emoji || \"\ud83d\udc3e\"}</div>\n          <div className=\"crp-info\">\n            <div className=\"crp-title\">{reel.title}</div>\n            <div className=\"crp-author\">@{reel.username}</div>\n          </div>\n        </div>\n\n        <div className=\"comments-list\">\n          {comments.length === 0 ? (\n            <div className=\"comments-empty\">\n              <div style={{ fontSize: \"2.5rem\" }}>\ud83d\udcac</div>\n              <p>No comments yet. Be the first!</p>\n            </div>\n          ) : (\n            comments.map(c => (\n              <div key={c.id} className=\"comment-item\">\n                <div className=\"comment-avatar\">\n                  {c.username?.[0]?.toUpperCase() || \"\ud83d\udc3e\"}\n                </div>\n                <div className=\"comment-body\">\n                  <div className=\"comment-username\">\n                    @{c.username}\n                    {c.userVerified && <BlueTick size={12} />}\n                    <span className=\"comment-time\">{timeAgo(c.createdAt)}</span>\n                  </div>\n                  <div className=\"comment-text\">{c.text}</div>\n                </div>\n                {(user?.uid === c.userId || (isSuperAdmin && adminMode)) && (\n                  <button className=\"comment-delete\" onClick={() => handleDelete(c.id)}>\ud83d\uddd1\ufe0f</button>\n                )}\n              </div>\n            ))\n          )}\n        </div>\n\n        <form className=\"comment-input-row\" onSubmit={handleSubmit}>\n          <input\n            ref={inputRef}\n            className=\"comment-input\"\n            value={text}\n            onChange={e => setText(e.target.value)}\n            placeholder={user ? \"Add a comment\u2026\" : \"Login to comment\u2026\"}\n            maxLength={300}\n            disabled={!user || submitting}\n            onClick={e => e.stopPropagation()}\n          />\n          <button\n            className=\"comment-submit\"\n            type=\"submit\"\n            disabled={!text.trim() || submitting || !user}\n          >\n            {submitting ? \"\u2026\" : \"Post\"}\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}\n"}}, {"type": "tool", "name": "write", "arguments": {"file_path": "artifacts/animal-x/src/components/UploadReel.jsx", "content": "import { useState, useRef } from \"react\";\nimport { collection, addDoc, serverTimestamp, doc, setDoc, increment } from \"firebase/firestore\";\nimport { db } from \"../utils/firebase\";\nimport { useAuth } from \"../context/AuthContext\";\nimport { moderateContent } from \"../pages/Reels\";\n\nconst CATEGORIES = [\"Mammals\",\"Birds\",\"Aquatic\",\"Reptiles\",\"Small Creatures\",\"Trees\",\"Mountains\",\"Sea\",\"Desert\"];\n\nconst WILDLIFE_KEYWORDS = [\n  \"animal\",\"lion\",\"tiger\",\"elephant\",\"eagle\",\"wolf\",\"dolphin\",\"whale\",\"shark\",\"cheetah\",\n  \"gorilla\",\"panda\",\"penguin\",\"crocodile\",\"leopard\",\"orca\",\"falcon\",\"bear\",\"fox\",\"lynx\",\n  \"wildlife\",\"nature\",\"wild\",\"jungle\",\"forest\",\"ocean\",\"reptile\",\"bird\",\"marine\",\"safari\",\n  \"savanna\",\"arctic\",\"mountain\",\"desert\",\"rainforest\",\"conservation\",\"habitat\",\"species\",\n];\n\nfunction checkModeration(title, desc, hashtags) {\n  const text = `${title} ${desc} ${hashtags}`.toLowerCase();\n  return WILDLIFE_KEYWORDS.some(w => text.includes(w));\n}\n\nasync function getStrikeInfo(uid) {\n  try {\n    const { getDoc } = await import(\"firebase/firestore\");\n    const snap = await getDoc(doc(db, \"userStrikes\", uid));\n    return snap.exists() ? snap.data() : { strikes: 0, banned: false };\n  } catch { return { strikes: 0, banned: false }; }\n}\n\nasync function addStrike(uid) {\n  try {\n    const ref = doc(db, \"userStrikes\", uid);\n    const { getDoc, updateDoc, setDoc: setDocFn } = await import(\"firebase/firestore\");\n    const snap = await getDoc(ref);\n    const data = snap.exists() ? snap.data() : { strikes: 0 };\n    const newStrikes = (data.strikes || 0) + 1;\n    const banned = newStrikes >= 3;\n    const banExpiry = banned ? Date.now() + 30 * 24 * 60 * 60 * 1000 : null;\n    await setDocFn(ref, { strikes: newStrikes, banned, banExpiry, lastStrike: Date.now() }, { merge: true });\n    return { strikes: newStrikes, banned };\n  } catch { return { strikes: 1, banned: false }; }\n}\n\nexport default function UploadReel({ onClose, onUploaded }) {\n  const { user, profile } = useAuth();\n  const [step, setStep] = useState(1); // 1=details, 2=video, 3=review\n  const [form, setForm] = useState({\n    title: \"\", description: \"\", hashtags: \"\", category: \"Mammals\", location: \"\",\n  });\n  const [videoFile, setVideoFile] = useState(null);\n  const [videoPreview, setVideoPreview] = useState(null);\n  const [thumbnailFile, setThumbnailFile] = useState(null);\n  const [uploading, setUploading] = useState(false);\n  const [progress, setProgress] = useState(0);\n  const [error, setError] = useState(null);\n  const [warning, setWarning] = useState(null);\n  const [banned, setBanned] = useState(false);\n  const videoInputRef = useRef(null);\n  const thumbInputRef = useRef(null);\n\n  function handleField(key, val) {\n    setForm(f => ({ ...f, [key]: val }));\n  }\n\n  function handleVideoFile(e) {\n    const f = e.target.files?.[0];\n    if (!f) return;\n    if (f.size > 200 * 1024 * 1024) { setError(\"Video must be under 200 MB.\"); return; }\n    if (!f.type.startsWith(\"video/\")) { setError(\"Please select a video file.\"); return; }\n    setVideoFile(f);\n    setVideoPreview(URL.createObjectURL(f));\n    setError(null);\n  }\n\n  async function uploadToStorage(file, contentType) {\n    const res = await fetch(\"/api/storage/uploads/request-url\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ name: file.name, size: file.size, contentType }),\n    });\n    if (!res.ok) throw new Error(\"Failed to get upload URL\");\n    const { uploadURL, objectPath } = await res.json();\n    const uploadRes = await fetch(uploadURL, {\n      method: \"PUT\",\n      headers: { \"Content-Type\": contentType },\n      body: file,\n    });\n    if (!uploadRes.ok) throw new Error(\"Upload failed\");\n    return objectPath;\n  }\n\n  async function handleNext() {\n    if (step === 1) {\n      if (!form.title.trim()) { setError(\"Please enter a title.\"); return; }\n      const isWildlife = checkModeration(form.title, form.description, form.hashtags);\n      if (!isWildlife) {\n        setWarning(\"\u26a0\ufe0f Content Warning: Your title/description doesn't appear to contain wildlife content. Animal X only allows wildlife, nature, and animal-related reels. Please revise or you may receive a strike.\");\n        return;\n      }\n      setWarning(null);\n      setStep(2);\n    } else if (step === 2) {\n      if (!videoFile) { setError(\"Please select a video.\"); return; }\n      setStep(3);\n    }\n  }\n\n  async function handleSubmit() {\n    if (!user) { alert(\"Please login first.\"); return; }\n    setUploading(true);\n    setError(null);\n    setProgress(10);\n    try {\n      const strikeInfo = await getStrikeInfo(user.uid);\n      if (strikeInfo.banned && strikeInfo.banExpiry > Date.now()) {\n        const days = Math.ceil((strikeInfo.banExpiry - Date.now()) / 86400000);\n        setBanned(true);\n        setError(`Your upload access is banned for ${days} more day(s) due to community guideline violations.`);\n        setUploading(false);\n        return;\n      }\n\n      let videoUrl = null;\n      let thumbnailUrl = null;\n\n      setProgress(20);\n      videoUrl = await uploadToStorage(videoFile, videoFile.type);\n      setProgress(70);\n\n      if (thumbnailFile) {\n        thumbnailUrl = await uploadToStorage(thumbnailFile, thumbnailFile.type);\n      }\n      setProgress(85);\n\n      const reelData = {\n        title: form.title.trim(),\n        desc: form.description.trim(),\n        hashtags: form.hashtags.trim(),\n        category: form.category,\n        location: form.location.trim() || null,\n        videoUrl,\n        thumbnailUrl: thumbnailUrl || null,\n        userId: user.uid,\n        username: profile?.username || user.name || user.email?.split(\"@\")[0],\n        userVerified: profile?.manualVerified || false,\n        userAvatar: profile?.avatar || null,\n        likes: 0,\n        views: 0,\n        comments: 0,\n        shares: 0,\n        createdAt: serverTimestamp(),\n        type: \"live\",\n        moderated: true,\n      };\n\n      await addDoc(collection(db, \"reels\"), reelData);\n      await setDoc(doc(db, \"users\", user.uid), { reels: increment(1) }, { merge: true });\n      setProgress(100);\n      onUploaded?.();\n    } catch (e) {\n      setError(\"Upload failed: \" + e.message);\n    }\n    setUploading(false);\n  }\n\n  return (\n    <div className=\"upload-modal-backdrop\" onClick={e => { if (e.target === e.currentTarget) onClose(); }}>\n      <div className=\"upload-modal\">\n        <div className=\"upload-modal-header\">\n          <div className=\"upload-modal-steps\">\n            {[1, 2, 3].map(s => (\n              <div key={s} className={`upload-step ${step === s ? \"active\" : step > s ? \"done\" : \"\"}`}>{s}</div>\n            ))}\n          </div>\n          <div className=\"upload-modal-title\">\n            {step === 1 ? \"\ud83d\udcdd Reel Details\" : step === 2 ? \"\ud83c\udfac Upload Video\" : \"\u2705 Review & Post\"}\n          </div>\n          <button className=\"upload-modal-close\" onClick={onClose}>\u2715</button>\n        </div>\n\n        {banned && (\n          <div className=\"upload-banned-msg\">\n            \ud83d\udeab Upload access banned. Please contact support.\n          </div>\n        )}\n\n        {error && <div className=\"upload-error\">{error}</div>}\n        {warning && (\n          <div className=\"upload-warning\">\n            {warning}\n            <div style={{ display: \"flex\", gap: 8, marginTop: 10 }}>\n              <button className=\"upload-warning-revise\" onClick={() => setWarning(null)}>\u270f\ufe0f Revise</button>\n              <button className=\"upload-warning-proceed\" onClick={async () => {\n                const { strikes } = await addStrike(user.uid);\n                setWarning(null);\n                if (strikes >= 3) { setBanned(true); setError(\"Upload access banned due to repeat violations.\"); }\n                else { alert(`\u26a0\ufe0f Strike ${strikes}/3 added. ${3 - strikes} violation(s) remaining before 30-day ban.`); }\n              }}>Post Anyway (Risk Strike)</button>\n            </div>\n          </div>\n        )}\n\n        {!warning && !banned && (\n          <>\n            {step === 1 && (\n              <div className=\"upload-form\">\n                <label className=\"upload-label\">Title *</label>\n                <input\n                  className=\"upload-input\"\n                  value={form.title}\n                  onChange={e => handleField(\"title\", e.target.value)}\n                  placeholder=\"e.g. Lion Pride at Dusk \ud83e\udd81\"\n                  maxLength={100}\n                />\n                <label className=\"upload-label\">Description</label>\n                <textarea\n                  className=\"upload-textarea\"\n                  value={form.description}\n                  onChange={e => handleField(\"description\", e.target.value)}\n                  placeholder=\"Describe your wildlife footage\u2026\"\n                  maxLength={500}\n                  rows={3}\n                />\n                <label className=\"upload-label\">Hashtags</label>\n                <input\n                  className=\"upload-input\"\n                  value={form.hashtags}\n                  onChange={e => handleField(\"hashtags\", e.target.value)}\n                  placeholder=\"#wildlife #lion #nature\"\n                />\n                <label className=\"upload-label\">Category</label>\n                <select\n                  className=\"upload-select\"\n                  value={form.category}\n                  onChange={e => handleField(\"category\", e.target.value)}\n                >\n                  {CATEGORIES.map(c => <option key={c}>{c}</option>)}\n                </select>\n                <label className=\"upload-label\">Location (optional)</label>\n                <input\n                  className=\"upload-input\"\n                  value={form.location}\n                  onChange={e => handleField(\"location\", e.target.value)}\n                  placeholder=\"e.g. Maasai Mara, Kenya\"\n                />\n                <div className=\"upload-moderation-note\">\n                  \ud83e\udd16 AI Moderation: Only wildlife, nature & animal content allowed.\n                </div>\n              </div>\n            )}\n\n            {step === 2 && (\n              <div className=\"upload-video-step\">\n                <div\n                  className=\"upload-drop-zone\"\n                  onClick={() => videoInputRef.current?.click()}\n                >\n                  {videoPreview ? (\n                    <video src={videoPreview} className=\"upload-preview-video\" muted playsInline />\n                  ) : (\n                    <>\n                      <div style={{ fontSize: \"4rem\" }}>\ud83c\udfac</div>\n                      <div className=\"upload-drop-text\">Tap to select video</div>\n                      <div className=\"upload-drop-hint\">MP4, MOV, WebM \u00b7 Max 200 MB</div>\n                    </>\n                  )}\n                </div>\n                <input\n                  ref={videoInputRef}\n                  type=\"file\"\n                  accept=\"video/*\"\n                  style={{ display: \"none\" }}\n                  onChange={handleVideoFile}\n                />\n                {videoFile && (\n                  <div className=\"upload-file-info\">\n                    \u2705 {videoFile.name} ({(videoFile.size / 1024 / 1024).toFixed(1)} MB)\n                  </div>\n                )}\n                <div className=\"upload-thumb-row\">\n                  <label className=\"upload-label\">Custom Thumbnail (optional)</label>\n                  <button className=\"upload-thumb-btn\" onClick={() => thumbInputRef.current?.click()}>\n                    {thumbnailFile ? \"\u2705 \" + thumbnailFile.name : \"\ud83d\udcf7 Choose thumbnail\"}\n                  </button>\n                  <input\n                    ref={thumbInputRef}\n                    type=\"file\"\n                    accept=\"image/*\"\n                    style={{ display: \"none\" }}\n                    onChange={e => setThumbnailFile(e.target.files?.[0] || null)}\n                  />\n                </div>\n              </div>\n            )}\n\n            {step === 3 && (\n              <div className=\"upload-review-step\">\n                <div className=\"upload-review-card\">\n                  <div className=\"upload-review-emoji\">\ud83c\udfac</div>\n                  <div className=\"upload-review-details\">\n                    <div className=\"upload-review-title\">{form.title}</div>\n                    <div className=\"upload-review-cat\">{form.category}{form.location ? \" \u00b7 \" + form.location : \"\"}</div>\n                    {form.hashtags && <div className=\"upload-review-tags\">{form.hashtags}</div>}\n                    <div className=\"upload-review-file\">{videoFile?.name}</div>\n                  </div>\n                </div>\n                <div className=\"upload-guidelines\">\n                  <div className=\"upload-guidelines-title\">\ud83d\udccb Community Guidelines</div>\n                  <ul>\n                    <li>\u2705 Wildlife, nature, animals, oceans, forests</li>\n                    <li>\u274c No unrelated content (gets rejected + strike)</li>\n                    <li>\u274c No violence, abuse, or harmful content</li>\n                    <li>3 strikes = 30-day upload ban</li>\n                  </ul>\n                </div>\n                {uploading && (\n                  <div className=\"upload-progress-wrap\">\n                    <div className=\"upload-progress-bar\" style={{ width: `${progress}%` }} />\n                    <div className=\"upload-progress-text\">Uploading\u2026 {progress}%</div>\n                  </div>\n                )}\n              </div>\n            )}\n\n            <div className=\"upload-modal-footer\">\n              {step > 1 && !uploading && (\n                <button className=\"upload-back-btn\" onClick={() => setStep(s => s - 1)}>\u2190 Back</button>\n              )}\n              {step < 3 ? (\n                <button className=\"upload-next-btn\" onClick={handleNext}>\n                  {step === 2 ? \"Review \u2192\" : \"Next \u2192\"}\n                </button>\n              ) : (\n                <button\n                  className=\"upload-post-btn\"\n                  onClick={handleSubmit}\n                  disabled={uploading}\n                >\n                  {uploading ? \"Posting\u2026\" : \"\ud83d\ude80 Post Reel\"}\n                </button>\n              )}\n            </div>\n          </>\n        )}\n      </div>\n    </div>\n  );\n}\n"}}]}, {"role": "tool", "content": [{"type": "text", "text": "File rewritten successfully at: artifacts/animal-x/src/pages/Reels.jsx"}]}, {"role": "tool", "content": [{"type": "text", "text": "File created successfully at: artifacts/animal-x/src/components/CommentsPanel.jsx"}]}, {"role": "tool", "content": [{"type": "text", "text": "File created successfully at: artifacts/animal-x/src/components/UploadReel.jsx"}]}]}
