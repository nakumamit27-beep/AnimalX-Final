{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "WildLingo Design System — extracted from the WildLingo wildlife explorer app. Dark deep-navy backgrounds, vivid green (#22c55e) primary accent, Inter typeface, 12px base radius. Edit values here only — never the generated src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#f0fdf4", "$description": "Soft nature-green tint — the lightest surface." },
      "foreground":          { "$value": "#0f172a" },
      "card":                { "$value": "#ffffff" },
      "cardForeground":      { "$value": "#0f172a" },
      "popover":             { "$value": "#ffffff" },
      "popoverForeground":   { "$value": "#0f172a" },
      "primary":             { "$value": "#16a34a", "$description": "Wildlife green — buttons, links, emphasis." },
      "primaryForeground":   { "$value": "#ffffff" },
      "secondary":           { "$value": "#e2e8f0" },
      "secondaryForeground": { "$value": "#0f172a" },
      "muted":               { "$value": "#f1f5f9" },
      "mutedForeground":     { "$value": "#64748b" },
      "accent":              { "$value": "#dcfce7" },
      "accentForeground":    { "$value": "#14532d" },
      "destructive":         { "$value": "#dc2626" },
      "destructiveForeground": { "$value": "#ffffff" },
      "border":              { "$value": "#e2e8f0" },
      "input":               { "$value": "#e2e8f0" },
      "ring":                { "$value": "#16a34a" },
      "chart1":              { "$value": "#16a34a" },
      "chart2":              { "$value": "#2563eb" },
      "chart3":              { "$value": "#d97706" },
      "chart4":              { "$value": "#7c3aed" },
      "chart5":              { "$value": "#dc2626" },
      "sidebar":             { "$value": "#f0fdf4" },
      "sidebarForeground":   { "$value": "#0f172a" },
      "sidebarBorder":       { "$value": "#d1fae5" },
      "sidebarPrimary":      { "$value": "#16a34a" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent":       { "$value": "#dcfce7" },
      "sidebarAccentForeground": { "$value": "#14532d" },
      "sidebarRing":         { "$value": "#16a34a" }
    },
    "dark": {
      "background":          { "$value": "#0a0f1e", "$description": "Deep navy — WildLingo's signature dark canvas." },
      "foreground":          { "$value": "#f1f5f9" },
      "card":                { "$value": "#1a2332", "$description": "Slightly lighter than background — card surfaces." },
      "cardForeground":      { "$value": "#f1f5f9" },
      "popover":             { "$value": "#111827" },
      "popoverForeground":   { "$value": "#f1f5f9" },
      "primary":             { "$value": "#22c55e", "$description": "Vivid wildlife green — the brand accent." },
      "primaryForeground":   { "$value": "#0a0f1e" },
      "secondary":           { "$value": "#1f2937" },
      "secondaryForeground": { "$value": "#f1f5f9" },
      "muted":               { "$value": "#111827" },
      "mutedForeground":     { "$value": "#94a3b8" },
      "accent":              { "$value": "#22c55e" },
      "accentForeground":    { "$value": "#0a0f1e" },
      "destructive":         { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#f1f5f9" },
      "border":              { "$value": "#2d3748" },
      "input":               { "$value": "#2d3748" },
      "ring":                { "$value": "#22c55e" },
      "chart1":              { "$value": "#22c55e" },
      "chart2":              { "$value": "#3b82f6" },
      "chart3":              { "$value": "#f59e0b" },
      "chart4":              { "$value": "#8b5cf6" },
      "chart5":              { "$value": "#ef4444" },
      "sidebar":             { "$value": "#0a0f1e" },
      "sidebarForeground":   { "$value": "#f1f5f9" },
      "sidebarBorder":       { "$value": "#2d3748" },
      "sidebarPrimary":      { "$value": "#22c55e" },
      "sidebarPrimaryForeground": { "$value": "#0a0f1e" },
      "sidebarAccent":       { "$value": "#1f2937" },
      "sidebarAccentForeground": { "$value": "#f1f5f9" },
      "sidebarRing":         { "$value": "#22c55e" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "sans-serif"], "$description": "Primary UI and body typeface — loaded from Google Fonts." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.75rem", "$description": "12px base corner radius — matching WildLingo's --radius: 12px." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
